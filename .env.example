# Vantara IQ — environment template.
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored
# and never leaves your machine, so every computer you work on needs its own
# copy. Without DATABASE_URL the app connects to nothing and every page
# renders empty — that is the usual cause of "I cloned it and there's no data".

# --- Database (Neon Postgres) -------------------------------------------
# Both come from the Neon dashboard → your project → Connection Details.
# DATABASE_URL is the pooled connection used at runtime.
# DATABASE_URL_UNPOOLED is the direct connection Prisma uses for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Claude (Anthropic) --------------------------------------------------
# console.anthropic.com → API Keys. Powers rate-sheet and material-list
# extraction. Without it those screens tell you AI isn't connected; the rest
# of the app works fine.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Vercel Blob (optional, but needed for uploads over ~4MB) ------------
# Vercel dashboard → Storage → your Blob store → tokens. Used for project
# maps, jobsite photos and large material lists. Without it, uploads over
# 4MB fail and the app falls back to posting small files through the server.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
