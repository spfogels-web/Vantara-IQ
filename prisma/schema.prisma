// Vantara IQ — data model.
//
// Top-level entities are tables; nested value-objects (contacts, rate sheets,
// compliance docs, daily line items) are stored as JSON so the rows map almost
// 1:1 onto the TypeScript types in src/lib/types.ts. That keeps the query seam
// (src/data/queries.ts) a thin translation and makes the mock -> DB swap clean.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  PM
  OFFICE
  /// Field supervisor working for Fortitude — staff access, same as a PM.
  SUPERVISOR
  SUBCONTRACTOR
}

enum SubState {
  INVITED
  ONBOARDING
  PENDING_REVIEW
  ACTIVE
  INACTIVE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("Enterprise")
  logoUrl   String?
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?
  name            String
  role            Role           @default(SUBCONTRACTOR)
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  organizationId  String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id])
  subcontractorId String?
  tasks           Task[]         @relation("TaskAssignee")
  createdAt       DateTime       @default(now())
}

model Customer {
  id             String             @id @default(cuid())
  name           String
  shortCode      String
  industry       String
  tone           String
  status         String
  logoTint       String
  logoUrl        String?
  location       String
  contacts       Json               @default("[]")
  billingEmail   String             @default("")
  paymentTerms   String             @default("Net 30")
  retainagePct   Float              @default(0.1)
  invoiceMinimum Int                @default(0)
  /// Work billed to this customer before it was tracked here — typed in by
  /// hand so the running total starts from where the business actually is,
  /// not from the first daily this app happened to see. Everything after it
  /// is computed from priced dailies, never entered.
  priorBilled    Int                @default(0)
  /// Legacy seeded figures. The tiles are computed from the projects' own
  /// material lists and dailies now; these stay only so old rows keep their
  /// history, and nothing reads them.
  contractValue  Int                @default(0)
  billedToDate   Int                @default(0)
  openAr         Int                @default(0)
  avgDaysToPay   Int                @default(0)
  rateSheet      Json               @default("[]")
  notes          String             @default("")
  since          String             @default("")
  projects       Project[]
  documents      CustomerDocument[]
  rates          CustomerRate[]
  contracts      Document[]
  invoices       Invoice[]
  createdAt      DateTime           @default(now())
}

/// A signed contract / agreement / tax doc on file for a customer.
model CustomerDocument {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  section    String
  fileName   String
  mediaType  String   @default("")
  sizeBytes  Int      @default(0)
  dataUrl    String
  uploadedBy String   @default("office")
  createdAt  DateTime @default(now())
}

/// One line of a customer's rate card — the basis for automated customer billing.
model CustomerRate {
  id             String   @id @default(cuid())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String
  code           String
  description    String   @default("")
  unit           String   @default("")
  rate           Float    @default(0)
  minimum        Float?
  rules          String   @default("")
  effectiveDate  String   @default("")
  expirationDate String   @default("")
  source         String   @default("manual")
  createdAt      DateTime @default(now())
}

model Project {
  id               String            @id @default(cuid())
  number           String            @default("")
  name             String
  client           String
  location         String
  status           String
  tone             String
  remainingFt      Int               @default(0)
  requiredFtPerDay Int               @default(0)
  actualFtPerDay   Int               @default(0)
  forecast         String            @default("")
  forecastTone     String            @default("info")
  health           Int               @default(80)
  pctComplete      Int               @default(0)
  crew             String            @default("Unassigned")
  /// Contract completion date, YYYY-MM-DD. Everything schedule-related is
  /// computed from this against a five-day production week — a required pace
  /// worked out on calendar days is quietly 30% too low.
  deadline         String            @default("")
  updatedAt        String            @default("")
  mapUrl           String?
  mapOriginalUrl   String?
  photoUrl         String?
  markups          Json?
  customer         Customer?         @relation(fields: [customerId], references: [id])
  customerId       String?
  dailies          Daily[]
  materials        ProjectMaterial[]
  materialImports  RateImport[]
  invoices         Invoice[]
  photos           ProjectPhoto[]
  rates            ProjectRate[]
  subInvoices      SubInvoice[]
  tasks            Task[]
  sheets           DailySheet[]
  /// Crews assigned to this job. This relation is what a subcontractor's
  /// access is decided by, so it is a real foreign key rather than a list of
  /// typed names — renaming a project can no longer revoke a crew's access,
  /// and deleting one cannot leave an assignment pointing at nothing.
  crews            Subcontractor[]   @relation("ProjectCrews")
  documents        Document[]
  createdAt        DateTime          @default(now())
  locateTickets    LocateTicket[]
}

/// A saved Globe-style subcontractor daily billing sheet. The grids are stored
/// as JSON because the sheet is a document — its shape is the paper form's, not
/// a schema we want to migrate every time a column moves. Submitting one also
/// writes a Daily, which is what billing and material draw-down read.
model DailySheet {
  id          String   @id @default(cuid())
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  /// Denormalised so a sheet still reads correctly if the project is renamed.
  projectName String   @default("")
  workDate    String   @default("")
  crewNumber  String   @default("")

  /// Which crew this sheet is being filed for, when the office fills it in on
  /// their behalf. A crew filing their own leaves this null and is identified
  /// by their login — this exists so a sheet typed up in the office is still
  /// attributed to the company that did the work, and therefore still becomes
  /// their pay statement.
  filedFor   Subcontractor? @relation(fields: [filedForId], references: [id], onDelete: SetNull)
  filedForId String?
  /// Header block: exchange/WO number, customer, job name, crew names, sign-offs.
  header     Json           @default("{}")
  /// Production grid: unit-code columns plus one entry per row.
  laborCodes Json           @default("[]")
  laborRows  Json           @default("[]")
  /// Material-only section.
  matCodes   Json           @default("[]")
  matRows    Json           @default("[]")
  /// The crew's own marked-up print, photographed or scanned. Distinct from
  /// `redlines` below: that is what somebody drew on the map in this app,
  /// this is the paper that came off the truck with the footages between peds
  /// written on it. It is the as-built record Globe asks for, and the thing
  /// that proves a quantity six months after the ground closed over it.
  redlineFiles Json     @default("[]")
  /// As-built redline drawn over the project map for this day's work.
  redlines   Json           @default("[]")
  /// Free-text notes from the crew — conditions, delays, anything the grid
  /// has no column for.
  notes      String         @default("")
  /// Field photos: peds, handholes, as-built evidence. Each entry carries its
  /// own capture/upload timestamp, so the record shows when it was taken and
  /// not merely when the sheet was submitted.
  photos     Json           @default("[]")
  status     String         @default("DRAFT") // DRAFT | SUBMITTED
  /// The Daily this sheet produced on submit, if any.
  dailyId    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([projectId])
}

/// Material actually tracked against a project — the thing the ops team manages.
/// Rows arrive here only after a human approves them on the review screen, so
/// nothing Claude extracted is ever counted as real stock on its own.
model ProjectMaterial {
  id             String   @id @default(cuid())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  /// Unit/material code as printed on the list (BFO, BFOV, ped, marker…).
  code           String   @default("")
  item           String   @default("")
  category       String   @default("Hardware")
  unit           String   @default("ea")
  /// Quantity the material list calls for.
  planned        Float    @default(0)
  /// Quantity released to the crew, and how much of it is in the ground.
  issued         Float    @default(0)
  installed      Float    @default(0)
  manufacturer   String   @default("")
  size           String   @default("")
  reelNumber     String   @default("")
  furnished      String   @default("")
  /// Whether this line is work we are actually performing.
  ///
  /// A material list is the customer's document and arrives with whatever is on
  /// it — including aerial work like riser guards on a job that is entirely
  /// underground. Deleting those rows would edit a record we did not write, so
  /// they stay on the list and drop out of the valuation instead. Out-of-scope
  /// work is not revenue, and pricing it inflates the job by exactly the amount
  /// nobody will ever invoice.
  inScope        Boolean  @default(true)
  /// Why it is out of scope, so the exclusion is explainable a year later.
  scopeNote      String   @default("")
  /// The RateImport these rows were approved from, for traceability.
  sourceImportId String   @default("")
  createdAt      DateTime @default(now())

  @@index([projectId])
}

/// What we pay a sub, per unit code. The mirror of CustomerRate: that side is
/// what we bill, this side is what the work costs. Margin is the difference
/// between the two on the same code — never a blended average, because two
/// codes on the same job can carry very different spreads.
/// How a bore is cut. The same unit code is paid differently depending on the
/// machine that cut it — a rate card prints both and expects the reader to know
/// which crew is which, which is not something a lookup can know.
enum BoreMethod {
  MISSILE
  DRILL
}

model SubcontractorRate {
  id              String        @id @default(cuid())
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  code            String
  description     String        @default("")
  unit            String        @default("")
  rate            Float         @default(0)
  minimum         Float?
  rules           String        @default("")
  effectiveDate   String        @default("")
  expirationDate  String        @default("")
  source          String        @default("manual")
  /// Set when a code is priced differently by method. Null means the rate
  /// applies however the work was done.
  method          BoreMethod?
  createdAt       DateTime      @default(now())

  @@index([subcontractorId])
}

model Subcontractor {
  id             String            @id @default(cuid())
  company        String
  lead           String            @default("")
  email          String            @default("")
  phone          String            @default("")
  location       String            @default("")
  trades         String[]          @default([])
  state          SubState          @default(PENDING_REVIEW)
  tone           String            @default("neutral")
  /// Jobs this crew is assigned to — the authority on what they can see.
  projects       Project[]         @relation("ProjectCrews")
  badges         CrewBadge[]
  ach            AchAuthorization?
  notifications  Notification[]
  filedSheets    DailySheet[]
  payStatements  SubInvoice[]
  tasks          Task[]            @relation("TaskCrew")
  /// When this crew agreed, in writing, to receive operational texts. A date
  /// rather than a flag: carriers require proof of consent, and "true" with
  /// no date proves nothing about when or under what wording.
  /// Whether this crew may see their own pay statements and rates in the
  /// portal. Off by default: several owners have their own people fill in the
  /// billing and do not want a rate card in front of them. The office can turn
  /// it on per crew for the ones who ask.
  showPayToCrew  Boolean   @default(false)
  /// Whether this crew's login may see the owner's own paperwork - EIN,
  /// banking, signatory, home address, references. Off by default: a foreman
  /// entering dailies signs in with the company account, and none of that is
  /// his to read. Documents and badges stay reachable so he can still upload
  /// a certificate.
  showOwnerDetailsToCrew Boolean @default(false)
  smsConsentAt   DateTime?
  /// Set the moment they reply STOP. Kept forever rather than cleared, so a
  /// re-onboarding can never quietly resubscribe someone who opted out.
  smsOptOutAt    DateTime?
  compliance     Json              @default("[]")
  complianceTone String            @default("neutral")
  scorecard      Json              @default("{}")
  crewSize       Int               @default(0)
  equipment      String[]          @default([])
  /// Which machine this crew bores with. Decides which of two same-coded rates
  /// they are paid, so it is asked once here rather than guessed per invoice.
  boreMethod     BoreMethod?
  logoUrl        String?
  /// Internal note on this crew — why their rates differ, what kit they run,
  /// anything the office needs to see beside the name. Never shown to the sub.
  notes          String            @default("")
  since          String            @default("")

  // ---- Vendor packet -------------------------------------------------------
  // What any contractor asks for before letting a crew on site. The sub fills
  // this in from their own portal; Fortitude reviews it.

  /// Legal entity name as it appears on the W-9 — often not the trading name.
  legalName            String @default("")
  dba                  String @default("")
  /// LLC / S-Corp / C-Corp / Partnership / Sole proprietor.
  entityType           String @default("")
  stateOfIncorporation String @default("")
  /// Federal EIN. Sensitive: it is on the W-9 we already hold, and it is the
  /// one field here that is worth stealing on its own.
  ein                  String @default("")
  website              String @default("")

  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  stateRegion  String @default("")
  postalCode   String @default("")

  /// Who signs contracts, and who chases payment — rarely the same person.
  signatoryName  String @default("")
  signatoryTitle String @default("")
  apContactName  String @default("")
  apEmail        String @default("")
  apPhone        String @default("")

  mobilePhone           String @default("")
  emergencyContactName  String @default("")
  emergencyContactPhone String @default("")

  /// The billing representative the agreement requires — every invoice, daily,
  /// as-built and payment query goes through this person.
  billingContactName    String @default("")
  billingContactTitle   String @default("")
  billingEmail          String @default("")
  billingMobile         String @default("")
  billingOfficePhone    String @default("")
  billingMailingAddress String @default("")

  paymentMethod   String @default("")
  paymentTerms    String @default("Net 21")
  remittanceEmail String @default("")

  contractorLicense String @default("")
  dotNumber         String @default("")
  locateCert        String @default("")

  /// Experience modification rate — the number a GC's insurer asks for first.
  emr             Float?
  oshaRecordables Int?
  safetyContact   String @default("")

  /// Two or three GCs they've worked for, as [{company, contact, phone, email}].
  references Json @default("[]")

  users     User[]
  contacts  CrewContact[]
  documents SubDocument[]
  rates     SubcontractorRate[]
  contracts Document[]
  createdAt DateTime            @default(now())
}

/// A file a subcontractor uploads to an onboarding/compliance section. Stored as
/// a data URL so it's downloadable without external blob storage (pilot).
model SubDocument {
  id              String        @id @default(cuid())
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  section         String
  fileName        String
  mediaType       String        @default("")
  sizeBytes       Int           @default(0)
  dataUrl         String
  uploadedBy      String        @default("subcontractor")
  createdAt       DateTime      @default(now())
}

/// Where a crew's pay statement stands.
/// How a statement settles. A crew does not choose this — standard pay runs
/// on the ACH details they gave at onboarding, and fast pay goes by wire.
enum PayMethod {
  ACH
  WIRE
}

enum SubInvoiceStatus {
  /// Building as their dailies are approved.
  DRAFT
  /// Sent to the crew, waiting on them.
  ISSUED
  /// The crew agreed the figures. Timestamped.
  ACCEPTED
  /// The crew says something is wrong, with a reason.
  DISPUTED
  PAID
  VOID
}

/// What Fortitude owes one crew for one week on one job.
///
/// The mirror of the customer invoice, and deliberately a separate record: the
/// customer's is what we bill, this is what the work costs, and the difference
/// between them is our margin. Sharing a table would put a crew one query away
/// from the number they must never see.
///
/// Priced at the crew's own signed card, at the rate in force on the work date.
model SubInvoice {
  id              String           @id @default(cuid())
  number          String           @unique
  subcontractor   Subcontractor    @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId       String?
  projectName     String           @default("")
  periodStart     String           @default("")
  periodEnd       String           @default("")
  status          SubInvoiceStatus @default(DRAFT)
  /// What we owe, from the lines. Frozen once issued.
  subtotal        Float            @default(0)
  issuedAt        DateTime?

  /// The record of them agreeing: who, and exactly when.
  acceptedAt  DateTime?
  acceptedBy  String    @default("")
  /// Their reason when they don't agree — required, because "denied" alone
  /// tells the office nothing to act on.
  disputeNote String    @default("")
  disputedAt  DateTime?
  disputedBy  String    @default("")

  /// Settlement window in calendar days. 30 unless fast pay is elected.
  termsDays Int @default(30)

  /// Fast pay — the crew trades a slice of the statement for getting paid
  /// sooner. Wire only, and that is not a preference they set: wire is what
  /// actually clears inside ten days.
  fastPay          Boolean   @default(false)
  /// Fee percentage, frozen at the moment it is elected. A house rate changed
  /// next quarter must not restate a statement somebody already agreed to.
  fastPayFeePct    Float     @default(0)
  fastPayElectedAt DateTime?
  fastPayElectedBy String    @default("")
  /// How this settles. Electing fast pay forces WIRE.
  payMethod        PayMethod @default(ACH)

  /// Fortitude's note back, when a dispute is settled.
  resolutionNote String           @default("")
  lines          SubInvoiceLine[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([subcontractorId, status])
  @@index([projectId])
}

/// One priced unit of a crew's own production.
///
/// The rate lives on the line rather than being looked up, so a card edited in
/// March cannot restate what a crew already accepted in January.
model SubInvoiceLine {
  id          String     @id @default(cuid())
  invoice     SubInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  /// The daily this came from. A plain id — deleting a daily must not silently
  /// remove a line from a statement a crew has accepted.
  dailyId     String     @default("")
  workDate    String     @default("")
  code        String     @default("")
  description String     @default("")
  unit        String     @default("")
  quantity    Float      @default(0)
  rate        Float      @default(0)
  amount      Float      @default(0)
  /// Produced by a rule rather than written on a sheet. See InvoiceLine.
  derived     Boolean    @default(false)

  /// Which rate card priced this line, recorded when it was priced. A crew is
  /// paid from a signed card, and "which card was that" is the first question
  /// asked when a figure is disputed — reading it back off the card today
  /// answers what the card says now, not what it said when this was priced.
  sourceCard String @default("")

  @@index([invoiceId])
  @@index([dailyId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  /// Waiting on somebody or something else. Carries a reason.
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A piece of work assigned to one person or one crew.
///
/// The assignee is either an employee or a subcontractor, never both and never
/// neither once assigned — "the office" owning a task is how it ends up owned
/// by nobody. Two nullable columns rather than one polymorphic id, so the
/// database can still enforce that each points at something real.
///
/// Deliberately not a project requirement: half of what needs chasing (a COI, a
/// rate card, a truck) belongs to no job at all.
model Task {
  id       String       @id @default(cuid())
  title    String
  detail   String       @default("")
  status   TaskStatus   @default(OPEN)
  priority TaskPriority @default(NORMAL)
  /// YYYY-MM-DD. Blank means no date, which is different from overdue.
  dueDate  String       @default("")

  /// An employee.
  assigneeUser   User?          @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeUserId String?
  /// Or a crew — the company, so it survives their staff changing.
  assigneeSub    Subcontractor? @relation("TaskCrew", fields: [assigneeSubId], references: [id], onDelete: SetNull)
  assigneeSubId  String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  createdByEmail String    @default("")
  /// Set when it reaches DONE, and cleared if it is reopened.
  completedAt    DateTime?
  completedBy    String    @default("")
  /// Why it is blocked, or why it was cancelled.
  statusNote     String    @default("")

  photos   TaskPhoto[]
  comments TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeUserId, status])
  @@index([assigneeSubId, status])
  @@index([projectId])
}

/// A photograph attached to a task.
///
/// Two kinds, and the distinction is the point: PROBLEM is what somebody found,
/// RESOLUTION is what was done about it. A task closed with a photo of the fix
/// beside the photo of the fault settles an argument that words never will.
///
/// These go to Blob like project photos — a picture of a cracked pedestal is
/// not a Social Security card, and the trade-off that makes badge documents
/// database-only does not apply.
model TaskPhoto {
  id             String   @id @default(cuid())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  url            String
  mediaType      String   @default("")
  sizeBytes      Int      @default(0)
  /// PROBLEM | RESOLUTION
  kind           String   @default("PROBLEM")
  caption        String   @default("")
  /// Where it was taken, when the device gave a position. Same honesty as the
  /// project gallery: a coordinate is stored only with a source behind it.
  lat            Float?
  lng            Float?
  locationSource String   @default("")
  uploadedBy     String   @default("")
  createdAt      DateTime @default(now())

  @@index([taskId])
}

/// A note on a task — the thread that turns an instruction into a conversation.
///
/// Status changes are written here too, so the history reads in one column
/// rather than being split between what was said and what was done.
model TaskComment {
  id          String   @id @default(cuid())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  body        String
  /// True when the row records a status change rather than something typed.
  systemNote  Boolean  @default(false)
  authorName  String   @default("")
  authorEmail String   @default("")
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Who looked at something sensitive, and when.
///
/// The interesting question about a bank account number is never "what is it"
/// but "who read it". Decryption is the moment worth recording, so it is
/// recorded — and kept separate from the record it concerns, so removing a
/// crew does not remove the history of who accessed their details.
model AccessLog {
  id          String   @id @default(cuid())
  /// Dotted, e.g. "ach.revealed".
  action      String
  actorUserId String   @default("")
  actorEmail  String   @default("")
  /// What was accessed, in words — this is read by a person, not a query.
  detail      String   @default("")
  subjectId   String   @default("")
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([subjectId])
}

/// A signed ACH authorisation — the crew telling us where to send their money.
///
/// One per subcontractor: a company has one place it gets paid, and allowing
/// several would mean choosing between them at payment time, which is exactly
/// the decision nobody wants to make by hand. Replacing it supersedes the old
/// one, and the signature and date move with it.
///
/// The account and routing numbers are encrypted at rest and never leave the
/// server in the clear — see src/lib/field-crypto.ts. Everything else here is
/// ordinary business information and stays queryable.
model AchAuthorization {
  id              String        @id @default(cuid())
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String        @unique

  // Who is being paid. Repeated from the vendor packet rather than referenced,
  // because this is a signed instrument: it has to say what it said on the day,
  // even if the packet is edited afterwards.
  legalName    String @default("")
  dba          String @default("")
  ein          String @default("")
  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  stateRegion  String @default("")
  postalCode   String @default("")
  phone        String @default("")
  email        String @default("")

  // Where the money goes.
  bankName         String @default("")
  bankAddressLine1 String @default("")
  bankCity         String @default("")
  bankStateRegion  String @default("")
  bankPostalCode   String @default("")
  /// "checking" | "savings"
  accountType      String @default("checking")
  /// AES-256-GCM ciphertext. Never sent to a client.
  accountNumberEnc String @default("")
  routingNumberEnc String @default("")
  /// Shown instead of the real thing, and enough to reconcile a remittance.
  accountLast4     String @default("")
  routingLast4     String @default("")

  // The authorisation itself.
  signerName       String    @default("")
  signerTitle      String    @default("")
  /// Drawn signature as a data URL.
  signatureDataUrl String    @default("")
  /// The date the signer put on it, as YYYY-MM-DD.
  signedDate       String    @default("")
  /// When the form was actually submitted — distinct from the date typed on it.
  submittedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BadgeStatus {
  /// The crew is still uploading.
  DRAFT
  /// Sent to Fortitude, waiting on a decision.
  SUBMITTED
  /// Cleared to collect material.
  APPROVED
  REJECTED
  /// Was cleared, no longer is.
  REVOKED
}

enum BadgeDocKind {
  LICENSE_FRONT
  LICENSE_BACK
  SSN_CARD
  PASSPORT
}

/// One named person cleared to collect material from the yard.
///
/// A badge is per person, not per company: the yard needs to know that the man
/// in front of them is the man on the list, which is why it carries a photo ID
/// and not just a company name.
model CrewBadge {
  id              String          @id @default(cuid())
  subcontractor   Subcontractor   @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  personName      String
  phone           String          @default("")
  status          BadgeStatus     @default(DRAFT)
  /// Licence expiry as YYYY-MM-DD. A badge stops being valid when the licence
  /// behind it does, which nobody remembers to check by hand.
  licenseExpires  String          @default("")
  reviewNote      String          @default("")
  reviewedBy      String          @default("")
  reviewedAt      DateTime?
  documents       BadgeDocument[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([subcontractorId, status])
}

/// A photo of an identity document, held for badge verification.
///
/// Deliberately stored in the database rather than object storage. The Blob
/// store this app uses elsewhere is public-read — unguessable URLs and no
/// access control — which is an acceptable trade for a photograph of a
/// pedestal and an unacceptable one for somebody's Social Security card or
/// passport. Here the row is only ever reachable through a query that has
/// already checked who is asking.
///
/// One document per kind per badge: re-uploading a licence front replaces it,
/// so an expired image cannot sit alongside its replacement.
model BadgeDocument {
  id         String       @id @default(cuid())
  badge      CrewBadge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId    String
  kind       BadgeDocKind
  fileName   String
  mediaType  String       @default("")
  sizeBytes  Int          @default(0)
  dataUrl    String
  uploadedBy String       @default("")
  createdAt  DateTime     @default(now())

  @@unique([badgeId, kind])
  @@index([badgeId])
}

model Daily {
  id            String   @id @default(cuid())
  sheetNumber   String   @default("")
  project       Project? @relation(fields: [projectId], references: [id])
  projectId     String?
  projectName   String   @default("")
  customer      String   @default("")
  subcontractor String   @default("")
  crew          String   @default("")
  workDate      String   @default("")

  /// Administration override for which billing week this daily falls in, as
  /// the Friday that closes that week. Empty means derive it from workDate,
  /// which is the rule: Saturday through Friday, and anything after Friday
  /// night belongs to the week that follows. The override exists because the
  /// office sometimes has to hold a day back or pull one forward, and doing
  /// that by editing the work date would falsify when the work happened.
  billingWeekEnd String   @default("")
  submittedAt    String   @default("")
  status         String   @default("Submitted")
  tone           String   @default("info")
  totalFt        Int      @default(0)
  billableAmount Int      @default(0)
  lineItems      Json     @default("[]")
  photos         Int      @default(0)
  hasAsBuilt     Boolean  @default(false)
  hasBoreLog     Boolean  @default(false)
  flags          Json     @default("[]")
  /// Supervisor review. A denial without a reason is useless to the crew that
  /// has to fix it, so the note is required when denying.
  reviewNote     String   @default("")
  reviewedBy     String   @default("")
  reviewedAt     String   @default("")
  createdAt      DateTime @default(now())
}

/// Where an invoice stands. DRAFT is staged and still recomputable; everything
/// from SENT on is a figure the customer has seen, and is frozen.
enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

/// A week's approved dailies, priced and sent as one bill.
///
/// Each daily is its own priced line group — that is how the work is approved
/// and how a dispute gets settled — but they leave together on a weekly cutoff
/// because that is what the customer's billing calendar expects.
///
/// The money columns are written once, at issue, from the rate card as it stood
/// that day. They are never recomputed. A rate card edited in March must not
/// silently restate a January invoice the customer has already paid.
model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     String?
  /// Denormalised so the invoice still reads if the project is renamed.
  projectName   String        @default("")
  /// Inclusive weekly cutoff this batch covers, as YYYY-MM-DD.
  periodStart   String        @default("")
  periodEnd     String        @default("")
  status        InvoiceStatus @default(DRAFT)
  /// Work priced at the customer's card.
  subtotal      Float         @default(0)
  /// Held back per the contract, captured at issue so a later change to the
  /// customer's terms cannot restate what was withheld on an old invoice.
  retainagePct  Float         @default(0)
  retainageHeld Float         @default(0)
  /// subtotal - retainageHeld. What the customer actually owes on this bill.
  amountDue     Float         @default(0)
  issuedAt      DateTime?
  dueAt         DateTime?
  voidedAt      DateTime?
  voidReason    String        @default("")
  notes         String        @default("")
  lines         InvoiceLine[]
  payments      Payment[]
  createdAt     DateTime      @default(now())

  @@index([customerId, status])
  @@index([projectId])
}

/// One priced unit code on an invoice, carrying the daily it came from.
///
/// The rate is stored on the line rather than looked up, for the same reason
/// the totals are: this is the number the customer was billed, not the number
/// the card happens to say today.
/// A billed unit.  marks a line a rule produced rather than a person
/// wrote — the microduct depth adder — so a figure nobody typed can always be
/// explained when a customer asks where it came from.
model InvoiceLine {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  /// The daily this production was reported on. Kept as a plain id — deleting
  /// a daily must not quietly delete a line off a sent invoice.
  dailyId     String  @default("")
  workDate    String  @default("")
  code        String  @default("")
  description String  @default("")
  unit        String  @default("")
  quantity    Float   @default(0)
  rate        Float   @default(0)
  amount      Float   @default(0)
  derived     Boolean @default(false)

  @@index([invoiceId])
  @@index([dailyId])
}

/// Money actually received against an invoice.
///
/// Recorded by hand from the bank or the remittance advice. Partial payments
/// are normal on this work, so an invoice is only PAID once the payments cover
/// it — nothing infers payment from an invoice merely being old.
model Payment {
  id         String   @id @default(cuid())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  amount     Float    @default(0)
  /// Date the money landed, as YYYY-MM-DD — the bank's date, not today's.
  receivedOn String   @default("")
  method     String   @default("")
  reference  String   @default("")
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([invoiceId])
}

/// What we expect to pay on one job, before a crew is chosen.
///
/// A job has to be priceable the day the material list lands, which is long
/// before anyone is assigned to it. These are the budgeted rates: the cost side
/// of the valuation falls back to them when no assigned crew has a signed card,
/// so a margin exists to decide on rather than a row of dashes.
///
/// Deliberately separate from SubcontractorRate. That table is what a specific
/// company signed and is what they get paid; this is a plan. Merging them would
/// let a budget figure quietly become the number on an invoice.
model ProjectRate {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  code        String
  description String   @default("")
  unit        String   @default("")
  rate        Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([projectId, code])
  @@index([projectId])
}

/// Where a photo's time and place came from.
///
/// This is the difference between a record and a story. A photo taken through
/// the app carries the device's own position at the moment of capture. A photo
/// chosen from the library was taken somewhere else, at some other time, and
/// stamping it with where the phone is *now* would manufacture evidence — so
/// its location comes from the file's own EXIF or it has none at all.
enum CaptureSource {
  CAMERA
  LIBRARY
}

/// A field photo or video on a project — evidence, and direction for the crew.
///
/// Two jobs in one record. As-built evidence has to be defensible: what was
/// built, where, and when, in a form that settles a dispute months later. A
/// direction shot is the opposite — it points a crew at a specific spot before
/// the work happens. Same capture path, different intent, so `purpose` says
/// which rather than leaving a gallery nobody can search.
model ProjectPhoto {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  /// Blob URL. Unguessable, but the store is public-read — fine for a job-site
  /// photo, and the reason contracts do not live here.
  url       String
  mediaType String  @default("")
  sizeBytes Int     @default(0)
  /// PHOTO | VIDEO
  kind      String  @default("PHOTO")

  source CaptureSource @default(LIBRARY)

  /// When the shutter fired, as distinct from when the file was uploaded —
  /// a crew photographing yesterday's work today is normal, and createdAt
  /// would quietly date the evidence wrong.
  capturedAt       DateTime?
  /// "camera" | "exif" | "file" — how capturedAt was established, so a weak
  /// source is visible rather than presented with the same authority as a
  /// real one.
  capturedAtSource String    @default("")

  lat            Float?
  lng            Float?
  /// Metres of uncertainty the device reported. A 2,000 m fix is a cell-tower
  /// guess and should not be drawn on a map like a survey point.
  accuracyM      Float?
  /// "device" | "exif" — never inferred, never filled in from the project.
  locationSource String @default("")

  caption String @default("")
  /// RECORD (evidence of work) | DIRECTION (instruction for the crew)
  purpose String @default("RECORD")

  uploadedBy String   @default("")
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

/// One project-specific onboarding invite link.
model Invite {
  token           String   @id
  projectId       String?
  projectName     String   @default("")
  customer        String   @default("")
  email           String?
  used            Boolean  @default(false)
  /// The subcontractor this invite created, once they start onboarding.
  ///
  /// This is what authorizes the rest of the flow. Onboarding legitimately runs
  /// before anyone has a login, so the actions that write to a subcontractor
  /// cannot demand a session — but they can demand the token that made this
  /// record, which binds a caller to one company and no other. Without it, an
  /// action taking a subcontractor id would let anyone write into any sub's
  /// file, including uploading documents into a competitor's packet.
  subcontractorId String?
  createdAt       DateTime @default(now())

  @@index([subcontractorId])
}

/// Feedback from the pilot account.
model Feedback {
  id        String   @id @default(cuid())
  category  String   @default("idea")
  message   String
  fromName  String?
  fromEmail String?
  page      String?
  createdAt DateTime @default(now())
}

enum RateDocType {
  GC_RATE_SHEET
  UNIT_DESCRIPTION
  MATERIAL_LIST
  SUB_RATE_CARD
}

enum ImportStatus {
  PROCESSING
  EXTRACTED
  APPROVED
  REJECTED
  FAILED
}

enum RowStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One uploaded rate/unit/material/rate-card document + its extraction job.
model RateImport {
  id            String         @id @default(cuid())
  docType       RateDocType
  fileName      String
  mediaType     String         @default("")
  status        ImportStatus   @default(PROCESSING)
  // Optional scoping the user provides at upload.
  customer      String         @default("")
  market        String         @default("")
  /// Free-text project label from the rate-import screen. When the import was
  /// started from a project page, `projectId` below is the authoritative link —
  /// this stays populated so renaming a project doesn't lose the label.
  project       String         @default("")
  linkedProject Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     String?
  summary       String         @default("")
  error         String         @default("")
  rows          ExtractedRow[]
  createdAt     DateTime       @default(now())
}

/// One extracted line item, kept as a reviewable draft until approved. The full
/// per-doc-type field set lives in `data`; the columns below drive the review UI.
model ExtractedRow {
  id          String     @id @default(cuid())
  import      RateImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  importId    String
  code        String     @default("")
  description String     @default("")
  unit        String     @default("")
  rate        Float?
  minimum     Float?
  rules       String     @default("")
  sourcePage  String     @default("")
  confidence  Float      @default(0)
  matchStatus String     @default("new")
  warning     String     @default("")
  status      RowStatus  @default(PENDING)
  data        Json       @default("{}")
  createdAt   DateTime   @default(now())
}

/**
 * ================================================================== *
 * Document Intelligence Center
 * A document is structured content, not a file. A version holds the
 * editor tree plus the variable values and clause versions resolved at
 * render time; the PDF is an output. That is what makes versioning,
 * diffing and comparison possible — a stack of PDFs cannot be diffed.
 * Executed versions are immutable. Corrections create a new version or
 * an amendment that supersedes; nothing overwrites signed history.
 * ==================================================================
 */

enum DocType {
  NDA
  MASTER_SUBCONTRACTOR_AGREEMENT
  PROJECT_SUBCONTRACTOR_AGREEMENT
  SUBCONTRACTOR_RATE_CARD
  CHANGE_ORDER
  PURCHASE_ORDER
  CUSTOMER_CONTRACT
  WORK_AUTHORIZATION
  INSURANCE_REQUEST
  W9_REQUEST
  LIEN_WAIVER
  SAFETY_FORM
  EMPLOYMENT_DOCUMENT
  VENDOR_AGREEMENT
  CLOSEOUT
  CUSTOM
}

enum DocStatus {
  DRAFT
  INTERNAL_REVIEW
  CHANGES_REQUESTED
  APPROVED
  READY_TO_SEND
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  EXECUTED
  EXPIRED
  SUPERSEDED
  ARCHIVED
  VOIDED
}

enum ApprovalStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

/// A reusable starting point. Holds slots; the resolver fills them.
model DocumentTemplate {
  id             String              @id @default(cuid())
  name           String
  type           DocType             @default(CUSTOM)
  category       String              @default("")
  description    String              @default("")
  /// Editor tree with variable slots and clause anchors.
  bodyJson       Json                @default("{}")
  version        Int                 @default(1)
  active         Boolean             @default(true)
  approvalStatus ApprovalStatus      @default(NOT_REQUESTED)
  approvedBy     String?
  approvedAt     DateTime?
  supersedesId   String?
  createdBy      String              @default("")
  documents      Document[]
  conditions     TemplateCondition[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([type, active])
}

/// A variable a template can reference. sourcePath is how it resolves
/// against live data, e.g. "subcontractor.legalName" or "project.number".
model TemplateVariable {
  id         String   @id @default(cuid())
  key        String   @unique
  label      String
  sourcePath String   @default("")
  kind       String   @default("text")
  /// Custom variables are author-defined; built-ins ship with the app.
  custom     Boolean  @default(false)
  sample     String   @default("")
  createdAt  DateTime @default(now())
}

/// "If project state is Georgia, insert the Georgia governing-law clause."
model TemplateCondition {
  id         String           @id @default(cuid())
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  /// Structured predicate, evaluated server-side. Never eval'd as code.
  expression Json             @default("{}")
  clause     Clause?          @relation(fields: [clauseId], references: [id])
  clauseId   String?
  sectionKey String           @default("")
  order      Int              @default(0)

  @@index([templateId])
}

/// A versioned block of contract language.
model Clause {
  id             String              @id @default(cuid())
  name           String
  category       String              @default("")
  body           String              @default("")
  version        Int                 @default(1)
  effectiveDate  String              @default("")
  /// Empty means "applies everywhere" for both of these.
  states         String[]            @default([])
  customerIds    String[]            @default([])
  active         Boolean             @default(true)
  approvalStatus ApprovalStatus      @default(NOT_REQUESTED)
  supersedesId   String?
  createdBy      String              @default("")
  conditions     TemplateCondition[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([category, active])
}

model Document {
  id               String            @id @default(cuid())
  type             DocType           @default(CUSTOM)
  title            String
  status           DocStatus         @default(DRAFT)
  /// Pointer to the version currently in force. Never deleted.
  currentVersionId String?
  template         DocumentTemplate? @relation(fields: [templateId], references: [id])
  templateId       String?

  customer        Customer?      @relation(fields: [customerId], references: [id])
  customerId      String?
  project         Project?       @relation(fields: [projectId], references: [id])
  projectId       String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id])
  subcontractorId String?
  rateCardId      String?
  dailyId         String?
  invoiceId       String?

  effectiveDate  String @default("")
  expirationDate String @default("")

  ownerId      String    @default("")
  createdBy    String    @default("")
  /// When this document was replaced by a newer agreement.
  supersedesId String?
  archivedAt   DateTime?
  /// Soft delete — legal records are never hard-deleted.
  deletedAt    DateTime?

  versions   DocumentVersion[]
  files      DocumentFile[]
  access     DocumentAccess[]
  favorites  DocumentFavorite[]
  auditTrail DocumentAuditEvent[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status])
  @@index([type])
  @@index([projectId])
  @@index([subcontractorId])
  @@index([customerId])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  versionNo  Int

  /// The editable content — the source of truth, not the PDF.
  bodyJson          Json @default("{}")
  /// What the variables resolved to when this version was rendered, so an
  /// executed document still reads correctly after the source data moves on.
  variablesSnapshot Json @default("{}")
  /// Which clause versions were used, for the same reason.
  clausesSnapshot   Json @default("[]")

  changeReason    String         @default("")
  changedSections String[]       @default([])
  approvalStatus  ApprovalStatus @default(NOT_REQUESTED)
  approvedBy      String?
  approvedAt      DateTime?

  /// SHA-256 of the rendered PDF, so a signature binds to exact content.
  checksum  String  @default("")
  pdfFileId String?

  /// Set the moment the document executes. A locked version is immutable.
  lockedAt  DateTime?
  createdBy String    @default("")
  createdAt DateTime  @default(now())

  fields   DocumentField[]
  comments DocumentComment[]

  @@unique([documentId, versionNo])
  @@index([documentId])
}

/// A placed field on a page — where a signer signs, dates or fills in.
model DocumentField {
  id        String          @id @default(cuid())
  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId String
  kind      String          @default("text")
  page      Int             @default(1)
  x         Float           @default(0)
  y         Float           @default(0)
  w         Float           @default(0)
  h         Float           @default(0)
  /// Which signer must complete it; null means an internal fill-in.
  signerId  String?
  required  Boolean         @default(true)
  label     String          @default("")
  value     String          @default("")
  options   String[]        @default([])
  sortOrder Int             @default(0)

  @@index([versionId])
}

/// A stored object. Originals and generated files are kept apart so an
/// upload is never overwritten by a render.
model DocumentFile {
  id         String    @id @default(cuid())
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String?
  versionId  String?
  /// original_upload | generated_pdf | executed_pdf | audit_certificate |
  /// signature_image | attachment
  kind       String    @default("attachment")
  storageKey String
  fileName   String    @default("")
  mime       String    @default("")
  sizeBytes  Int       @default(0)
  checksum   String    @default("")
  scanStatus String    @default("pending")
  uploadedBy String    @default("")
  createdAt  DateTime  @default(now())

  @@index([documentId])
}

model DocumentComment {
  id         String          @id @default(cuid())
  version    DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId  String
  anchor     String          @default("")
  body       String
  /// Internal notes are never visible to a subcontractor.
  internal   Boolean         @default(true)
  authorId   String          @default("")
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([versionId])
}

/// An explicit share. A crew sees a document because of a row here or
/// because it is addressed to their company — never by guessing an id.
model DocumentAccess {
  id              String   @id @default(cuid())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId      String
  subcontractorId String?
  userId          String?
  canView         Boolean  @default(true)
  canSign         Boolean  @default(false)
  sharedBy        String   @default("")
  createdAt       DateTime @default(now())

  @@index([documentId])
  @@index([subcontractorId])
}

model DocumentFavorite {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  userId     String
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
}

/// Append-only. Every action that touches a document lands here.
model DocumentAuditEvent {
  id          String   @id @default(cuid())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String
  versionId   String?
  action      String
  actorUserId String?
  actorEmail  String   @default("")
  detail      Json     @default("{}")
  ip          String   @default("")
  userAgent   String   @default("")
  at          DateTime @default(now())

  @@index([documentId, at])
}

/**
 * ------------------------------------------------------------------------- *
 * Prospects — the pipeline before anybody is on a job.
 * Three different relationships share one table because the office works them
 * the same way: find them, talk to them, decide. What differs is the direction
 * of the money. A WORKER or a CREW is somebody Fortitude would pay; a PRIME is
 * somebody who would pay Fortitude. Keeping them together means one list of
 * "who do we know in this state", which is the question that actually gets
 * asked when a job comes up somewhere new.
 * -------------------------------------------------------------------------
 */

enum ProspectKind {
  /// An individual — operator, laborer, fusion tech — hired directly.
  WORKER
  /// A crew company that could run production under Fortitude.
  SUBCONTRACTOR
  /// A general or prime contractor Fortitude would work for. Future business.
  PRIME
}

/// How far along a conversation is. LOST and DORMANT are kept apart on
/// purpose: lost is a decision, dormant is a phone number worth trying again.
enum ProspectStage {
  NEW
  CONTACTED
  QUALIFYING
  IN_DISCUSSION
  WON
  LOST
  DORMANT
}

model Prospect {
  id    String        @id @default(cuid())
  kind  ProspectKind
  stage ProspectStage @default(NEW)

  /// Company name, or the person's name when this is a worker.
  name        String
  contactName String @default("")
  contactRole String @default("")
  email       String @default("")
  phone       String @default("")
  website     String @default("")

  /// Where they are based.
  city      String   @default("")
  homeState String   @default("")
  /// States they will actually travel to or hold work in. A prospect based in
  /// one state who works four is the normal case, not the exception.
  states    String[] @default([])
  /// Named markets — "Greenville-Spartanburg", "Atlanta Metro". For a prime,
  /// these are the markets they hold; for a crew, where they want work.
  markets   String[] @default([])

  trades    String[] @default([])
  crewSize  Int      @default(0)
  equipment String[] @default([])

  /// 0 = unrated. Gut-feel ranking so the good ones stay findable.
  rating Int    @default(0)
  /// Referral, jobsite, cold call — worth knowing which channels work.
  source String @default("")
  notes  String @default("")

  /// The single next thing somebody has to do, and by when. A pipeline without
  /// this is just a list of names.
  nextStep    String @default("")
  nextStepDue String @default("")
  lastContact String @default("")
  owner       String @default("")

  /// Set when a won crew is promoted into the real subcontractor roster, so
  /// the pipeline keeps its history instead of the record vanishing.
  convertedSubcontractorId String?
  convertedAt              DateTime?

  activities ProspectActivity[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([kind, stage])
  @@index([homeState])
}

/// One logged touch — a call, an email, a note, or a stage change.
model ProspectActivity {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  /// note | call | email | meeting | stage
  kind       String   @default("note")
  body       String   @default("")
  author     String   @default("")
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

/// Who a notification is for.
///
/// Not a preference — a boundary. Staff notifications name crews, jobs and
/// money across the whole book; a crew's name what happened to their own work.
/// The two are never the same row, so there is no filter to get wrong.
enum NotifyAudience {
  STAFF
  SUBCONTRACTOR
}

/// Something that happened which somebody should know about.
///
/// Written at the moment of the event rather than derived by polling, so the
/// record says what happened and when, and a notification cannot quietly
/// change its mind later because the underlying row moved on.
model Notification {
  id              String         @id @default(cuid())
  audience        NotifyAudience
  /// Set when the audience is one crew. Null for the office.
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String?

  title    String
  detail   String @default("")
  /// Where to go to act on it.
  href     String @default("")
  /// daily | billing | compliance | crew | system
  category String @default("system")
  tone     String @default("info")

  /// Who did the thing, for the office to see at a glance.
  actor String @default("")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([audience, subcontractorId, readAt])
  @@index([createdAt])
}

/// What a utility member said about a ticket.
///
/// UNKNOWN is a real state and the default: a member who has not answered is
/// not a member who has cleared. That distinction is the whole reason for
/// recording responses one by one rather than marking a ticket "done".
enum LocateResponseStatus {
  MARKED
  CLEAR
  NOT_COMPLETE
  DELAYED
  UNKNOWN
}

/// A Georgia 811 locate ticket.
///
/// Dates are held as YYYY-MM-DD because a ticket expires on a day, not at a
/// moment, and storing a timestamp invites a timezone to move it. The expiry
/// and update-by dates are stored as 811 stated them where known; blank means
/// nobody has said, and the app computes a fallback and labels it as computed.
model LocateTicket {
  id       String @id @default(cuid())
  number   String
  /// 811 re-issues under the same number with a revision.
  revision String @default("")

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  street      String @default("")
  crossStreet String @default("")
  city        String @default("")
  county      String @default("")
  /// What the ticket says the work is — bore, trench, plow.
  workType    String @default("")
  /// NORMAL | CANCEL | UPDATE | EMERGENCY | RETRANSMIT, as stated. A cancel
  /// ticket is not a locate: it withdraws one, and must never read as in force.
  ticketType  String @default("")
  /// The text this was read from, kept so a misread can be diagnosed against
  /// what actually arrived rather than against a memory of it.
  sourceText  String @default("")

  /// The clock. All calendar days.
  calledInOn    String @default("")
  /// "Effective On" — the ticket is not in force before this.
  workToBeginOn String @default("")
  /// "Response By" — when the members owe an answer. Past this with silence
  /// is a call to make, not a wait to keep having.
  responseBy    String @default("")
  /// "Updateable On" — the earliest an update can be filed.
  updateableOn  String @default("")
  updateBy      String @default("")
  expiresOn     String @default("")

  /// The dig site as 811 recorded it. Held because it is the only coordinate
  /// anyone states for this work, and it is what puts a ticket on a map
  /// beside the crews.
  lat                Float?
  lng                Float?
  /// Verbatim from the ticket. These say where to start and what to walk, and
  /// paraphrasing them would lose the only site-specific instruction there is.
  locateInstructions String @default("")

  /// Set when a ticket is cancelled or superseded, so it drops out of the
  /// board without being deleted — a locate history is a safety record.
  closedOn String @default("")
  notes    String @default("")

  responses LocateResponse[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([number, revision])
  @@index([projectId])
  @@index([expiresOn])
}

model LocateResponse {
  id       String       @id @default(cuid())
  ticket   LocateTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  /// The utility, as 811 names them.
  member       String
  /// The 811 member code, which is what appears on a response.
  code         String               @default("")
  /// Gas, Electric, Water, Telecommunication. Not decoration: what is in the
  /// ground decides how badly a missing response matters.
  facilityType String               @default("")
  status       LocateResponseStatus @default(UNKNOWN)
  respondedOn  String               @default("")
  note         String               @default("")

  @@unique([ticketId, member])
  @@index([ticketId])
}


/// A person at a subcontractor — the foreman who files dailies, the office
/// manager who chases an invoice, the owner who signs.
///
/// One company had one phone number and one email, which is fine until the
/// foreman entering the billing is not the owner whose number is on the packet.
/// A task assigned to a person could not be texted at all, because a person had
/// nowhere to hold a number.
///
/// Captured at the top of onboarding on purpose: a crew who abandons the form
/// half way still leaves behind who they are and how to ring them, which is the
/// thing that gets forgotten when several companies are onboarding at once.
model CrewContact {
  id              String        @id @default(cuid())
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  name            String        @default("")
  /// Foreman, owner, office — free text, because job titles in this trade are
  /// not a list anybody agrees on.
  role            String        @default("")
  phone           String        @default("")
  email           String        @default("")
  /// The one to ring when it is not about a specific job.
  primary         Boolean       @default(false)
  /// Their own consent, because consent belongs to a handset and not a company.
  smsConsentAt    DateTime?
  smsOptOutAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([subcontractorId])
}