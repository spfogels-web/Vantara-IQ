// Vantara IQ — data model.
//
// Top-level entities are tables; nested value-objects (contacts, rate sheets,
// compliance docs, daily line items) are stored as JSON so the rows map almost
// 1:1 onto the TypeScript types in src/lib/types.ts. That keeps the query seam
// (src/data/queries.ts) a thin translation and makes the mock -> DB swap clean.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  PM
  OFFICE
  /// Field supervisor working for Fortitude — staff access, same as a PM.
  SUPERVISOR
  SUBCONTRACTOR
}

/// What somebody does inside a subcontractor.
///
/// Role above says which side of the table they sit on — Fortitude or a crew.
/// This says who they are within their own company, which is a different
/// question and the one that decides what money they can see.
///
/// An owner asked for his EIN and bank details off the account his foreman
/// uses to file dailies. That was solved with a switch per company, which
/// works while a company is one login and stops working the moment it is
/// four people.
enum SubUserRole {
  /// Signed the subcontract. Sees pay, rates and their own owner details.
  OWNER
  /// Runs the office for them — invoicing, packet, documents.
  ADMIN
  PM
  FOREMAN
  SUPERVISOR
}

enum SubState {
  INVITED
  ONBOARDING
  PENDING_REVIEW
  ACTIVE
  INACTIVE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("Enterprise")
  logoUrl   String?
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?
  name            String

  /// Mobile number for job alerts. Staff get texted the same way crews do,
  /// and the same rules apply: nothing is sent without consent, and a STOP
  /// from this handset stops it.
  phone         String    @default("")
  /// When they agreed, and the wording they agreed to as it read that day.
  /// Null means they have never agreed and nothing may be sent.
  smsConsentAt  DateTime?
  smsConsentText String   @default("")
  /// Set when they reply STOP. Clears only when they reply START.
  smsOptOutAt   DateTime?
  role            Role           @default(SUBCONTRACTOR)
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  organizationId  String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id])
  subcontractorId String?
  /// Their job inside that company. Defaults to OWNER because every account
  /// that existed before this was the owner or their nominee — the person who
  /// onboarded the company. Only invited users get anything else.
  subUserRole     SubUserRole    @default(OWNER)
  tasks           Task[]         @relation("TaskAssignee")
  conversationSeat ConversationParticipant[] @relation("ConversationMember")
  prospectsOwned   Prospect[]                @relation("ProspectOwner")
  messagesSent     Message[]                 @relation("MessageAuthor")
  messagesTo       MessageDelivery[]         @relation("MessageRecipient")
  locatesOwned       LocateTicket[]      @relation("LocateAssignee")
  locatesAssigned    ContractorLocate[]  @relation("ContractorLocateAssignee")
  locatesWalked      ContractorLocate[]  @relation("ContractorLocateLocator")
  locateChecks       LocateTicketCheck[] @relation("LocateCheckRequester")

  /// How many times this person has signed in, and when they last did.
  ///
  /// Counted rather than derived from a session log because the question the
  /// office actually asks is "is this crew using the system at all" — and a
  /// crew whose owner signed in once in June and never again is a crew filing
  /// dailies on paper. A count with no date cannot tell you that, and a date
  /// with no count cannot tell you whether it was a habit or a single look.
  loginCount  Int       @default(0)
  lastLoginAt DateTime?

  createdAt       DateTime       @default(now())
}

model Customer {
  id             String             @id @default(cuid())
  name           String
  shortCode      String
  industry       String
  tone           String
  status         String
  logoTint       String
  logoUrl        String?
  location       String
  contacts       Json               @default("[]")
  billingEmail   String             @default("")
  paymentTerms   String             @default("Net 30")
  retainagePct   Float              @default(0.1)
  invoiceMinimum Int                @default(0)
  /// Work billed to this customer before it was tracked here — typed in by
  /// hand so the running total starts from where the business actually is,
  /// not from the first daily this app happened to see. Everything after it
  /// is computed from priced dailies, never entered.
  priorBilled    Int                @default(0)
  /// Legacy seeded figures. The tiles are computed from the projects' own
  /// material lists and dailies now; these stay only so old rows keep their
  /// history, and nothing reads them.
  contractValue  Int                @default(0)
  billedToDate   Int                @default(0)
  openAr         Int                @default(0)
  avgDaysToPay   Int                @default(0)
  rateSheet      Json               @default("[]")
  notes          String             @default("")
  since          String             @default("")
  projects       Project[]
  documents      CustomerDocument[]
  rates          CustomerRate[]
  contracts      Document[]
  invoices       Invoice[]
  createdAt      DateTime           @default(now())
}

/// A signed contract / agreement / tax doc on file for a customer.
model CustomerDocument {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  section    String
  fileName   String
  mediaType  String   @default("")
  sizeBytes  Int      @default(0)
  dataUrl    String
  uploadedBy String   @default("office")
  createdAt  DateTime @default(now())
}

/// One line of a customer's rate card — the basis for automated customer billing.
model CustomerRate {
  id             String   @id @default(cuid())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String
  /// Which market this price applies in — see src/lib/markets.ts.
  ///
  /// Empty means every market, which is the right default: most customers
  /// work one market and a card that follows them everywhere is what people
  /// expect. A market-specific row wins over a blank one, so Trawick can
  /// hold a South Georgia card and an Alabama card at different prices
  /// under the same customer without either overwriting the other.
  market         String   @default("")
  code           String
  description    String   @default("")
  unit           String   @default("")
  rate           Float    @default(0)
  minimum        Float?
  rules          String   @default("")
  effectiveDate  String   @default("")
  expirationDate String   @default("")
  source         String   @default("manual")
  createdAt      DateTime @default(now())
}

model Project {
  materialInstances MaterialInstance[]
  conversations    Conversation[]
  id               String            @id @default(cuid())
  number           String            @default("")
  name             String
  client           String
  location         String
  status           String
  tone             String
  remainingFt      Int               @default(0)
  requiredFtPerDay Int               @default(0)
  actualFtPerDay   Int               @default(0)
  forecast         String            @default("")
  forecastTone     String            @default("info")
  health           Int               @default(80)
  pctComplete      Int               @default(0)
  crew             String            @default("Unassigned")
  /// Contract completion date, YYYY-MM-DD. Everything schedule-related is
  /// computed from this against a five-day production week — a required pace
  /// worked out on calendar days is quietly 30% too low.
  deadline         String            @default("")

  /// When the job was called finished, by a person.
  ///
  /// Percent complete is otherwise derived from placed footage over planned
  /// route, and a real job does not end on that ratio reaching 100 — the
  /// material list overestimates, punch work lands outside the plan, and a
  /// crew walks off a finished job at 94%. Somebody has to say it is done.
  ///
  /// Null means still running. Set means complete: the derivation stops and
  /// the job reads 100% with nothing left.
  completedAt      DateTime?
  updatedAt        String            @default("")
  /// Which market this job sits in — see src/lib/markets.ts.
  ///
  /// Stored rather than derived from the town every read, because a person
  /// must be able to correct it: two of these markets share a prime and pay
  /// differently, so a job in the wrong one is billed at the wrong rate.
  /// Empty means nobody has set it, which the filter shows as unassigned.
  market           String            @default("")
  mapUrl           String?
  mapOriginalUrl   String?
  photoUrl         String?
  markups          Json?
  customer         Customer?         @relation(fields: [customerId], references: [id])
  customerId       String?
  dailies          Daily[]
  materials        ProjectMaterial[]
  materialImports  RateImport[]
  invoices         Invoice[]
  photos           ProjectPhoto[]
  rates            ProjectRate[]
  subInvoices      SubInvoice[]
  tasks            Task[]
  sheets           DailySheet[]
  /// Crews assigned to this job. This relation is what a subcontractor's
  /// access is decided by, so it is a real foreign key rather than a list of
  /// typed names — renaming a project can no longer revoke a crew's access,
  /// and deleting one cannot leave an assignment pointing at nothing.
  crews            Subcontractor[]   @relation("ProjectCrews")
  documents        Document[]
  createdAt        DateTime          @default(now())
  locateTickets    LocateTicket[]
  /// Who locates what on this job. Empty means every utility is a member
  /// locate, which is the ordinary case.
  locateRules      ProjectLocateRule[]
}

/// A saved Globe-style subcontractor daily billing sheet. The grids are stored
/// as JSON because the sheet is a document — its shape is the paper form's, not
/// a schema we want to migrate every time a column moves. Submitting one also
/// writes a Daily, which is what billing and material draw-down read.
model DailySheet {
  id          String   @id @default(cuid())
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  /// Denormalised so a sheet still reads correctly if the project is renamed.
  projectName String   @default("")
  workDate    String   @default("")
  crewNumber  String   @default("")
  /// The road or roads this day's work was on.
  ///
  /// Its own column rather than a key in the header blob, because that blob
  /// is Globe's form and this is not on Globe's form — it sits above it, in
  /// Fortitude's own strip, and never prints.
  roads       String   @default("")

  /// Which crew this sheet is being filed for, when the office fills it in on
  /// their behalf. A crew filing their own leaves this null and is identified
  /// by their login — this exists so a sheet typed up in the office is still
  /// attributed to the company that did the work, and therefore still becomes
  /// their pay statement.
  filedFor   Subcontractor? @relation(fields: [filedForId], references: [id], onDelete: SetNull)
  filedForId String?
  /// Header block: exchange/WO number, customer, job name, crew names, sign-offs.
  header     Json           @default("{}")
  /// Production grid: unit-code columns plus one entry per row.
  laborCodes Json           @default("[]")
  laborRows  Json           @default("[]")
  /// Material-only section.
  matCodes   Json           @default("[]")
  matRows    Json           @default("[]")
  /// The crew's own marked-up print, photographed or scanned. Distinct from
  /// `redlines` below: that is what somebody drew on the map in this app,
  /// this is the paper that came off the truck with the footages between peds
  /// written on it. It is the as-built record Globe asks for, and the thing
  /// that proves a quantity six months after the ground closed over it.
  redlineFiles Json     @default("[]")
  /// As-built redline drawn over the project map for this day's work.
  redlines   Json           @default("[]")
  /// Free-text notes from the crew — conditions, delays, anything the grid
  /// has no column for.
  notes      String         @default("")
  /// Field photos: peds, handholes, as-built evidence. Each entry carries its
  /// own capture/upload timestamp, so the record shows when it was taken and
  /// not merely when the sheet was submitted.
  photos     Json           @default("[]")
  status     String         @default("DRAFT") // DRAFT | SUBMITTED
  /// The Daily this sheet produced on submit, if any.
  dailyId    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([projectId])
}

/// Material actually tracked against a project — the thing the ops team manages.
/// Rows arrive here only after a human approves them on the review screen, so
/// nothing Claude extracted is ever counted as real stock on its own.
model ProjectMaterial {
  id             String   @id @default(cuid())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  /// Unit/material code as printed on the list (BFO, BFOV, ped, marker…).
  code           String   @default("")
  item           String   @default("")
  category       String   @default("Hardware")
  unit           String   @default("ea")
  /// Quantity the material list calls for.
  planned        Float    @default(0)
  /// Quantity released to the crew, and how much of it is in the ground.
  issued         Float    @default(0)
  installed      Float    @default(0)
  manufacturer   String   @default("")
  size           String   @default("")
  reelNumber     String   @default("")
  furnished      String   @default("")
  /// Whether this line is work we are actually performing.
  ///
  /// A material list is the customer's document and arrives with whatever is on
  /// it — including aerial work like riser guards on a job that is entirely
  /// underground. Deleting those rows would edit a record we did not write, so
  /// they stay on the list and drop out of the valuation instead. Out-of-scope
  /// work is not revenue, and pricing it inflates the job by exactly the amount
  /// nobody will ever invoice.
  inScope        Boolean  @default(true)
  /// Why it is out of scope, so the exclusion is explainable a year later.
  scopeNote      String   @default("")
  /// The RateImport these rows were approved from, for traceability.
  sourceImportId String   @default("")
  createdAt      DateTime @default(now())

  @@index([projectId])
}

/// What we pay a sub, per unit code. The mirror of CustomerRate: that side is
/// what we bill, this side is what the work costs. Margin is the difference
/// between the two on the same code — never a blended average, because two
/// codes on the same job can carry very different spreads.
/// How a bore is cut. The same unit code is paid differently depending on the
/// machine that cut it — a rate card prints both and expects the reader to know
/// which crew is which, which is not something a lookup can know.
enum BoreMethod {
  MISSILE
  DRILL
}

model SubcontractorRate {
  id              String        @id @default(cuid())
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  /// Which market this price applies in — see src/lib/markets.ts.
  ///
  /// Empty means every market, which is the right default: most customers
  /// work one market and a card that follows them everywhere is what people
  /// expect. A market-specific row wins over a blank one, so Trawick can
  /// hold a South Georgia card and an Alabama card at different prices
  /// under the same customer without either overwriting the other.
  market          String        @default("")
  code            String
  description     String        @default("")
  unit            String        @default("")
  rate            Float         @default(0)
  minimum         Float?
  rules           String        @default("")
  effectiveDate   String        @default("")
  expirationDate  String        @default("")
  source          String        @default("manual")
  /// Set when a code is priced differently by method. Null means the rate
  /// applies however the work was done.
  method          BoreMethod?
  createdAt       DateTime      @default(now())

  @@index([subcontractorId])
}

model Subcontractor {
  id             String            @id @default(cuid())
  company        String
  lead           String            @default("")
  email          String            @default("")
  phone          String            @default("")
  location       String            @default("")
  trades         String[]          @default([])
  state          SubState          @default(PENDING_REVIEW)
  tone           String            @default("neutral")
  /// Jobs this crew is assigned to — the authority on what they can see.
  projects       Project[]         @relation("ProjectCrews")
  badges         CrewBadge[]
  ach            AchAuthorization?
  notifications  Notification[]
  filedSheets    DailySheet[]
  payStatements  SubInvoice[]
  tasks          Task[]            @relation("TaskCrew")
  /// When this crew agreed, in writing, to receive operational texts. A date
  /// rather than a flag: carriers require proof of consent, and "true" with
  /// no date proves nothing about when or under what wording.
  /// Whether this crew may see their own pay statements and rates in the
  /// portal. Off by default: several owners have their own people fill in the
  /// billing and do not want a rate card in front of them. The office can turn
  /// it on per crew for the ones who ask.
  showPayToCrew  Boolean   @default(false)
  /// Whether this crew's login may see the owner's own paperwork - EIN,
  /// banking, signatory, home address, references. Off by default: a foreman
  /// entering dailies signs in with the company account, and none of that is
  /// his to read. Documents and badges stay reachable so he can still upload
  /// a certificate.
  showOwnerDetailsToCrew Boolean @default(false)
  userInvites            SubUserInvite[]
  conversations          Conversation[]
  conversationSeat       ConversationParticipant[] @relation("ConversationCrew")
  materialCustody        MaterialInstance[]        @relation("MaterialCustodian")
  messageContacts        MessageContact[]
  smsConsentAt   DateTime?
  /// Set the moment they reply STOP. Kept forever rather than cleared, so a
  /// re-onboarding can never quietly resubscribe someone who opted out.
  smsOptOutAt    DateTime?
  compliance     Json              @default("[]")
  complianceTone String            @default("neutral")
  scorecard      Json              @default("{}")
  crewSize       Int               @default(0)
  equipment      String[]          @default([])
  /// Which machine this crew bores with. Decides which of two same-coded rates
  /// they are paid, so it is asked once here rather than guessed per invoice.
  boreMethod     BoreMethod?
  logoUrl        String?
  /// Internal note on this crew — why their rates differ, what kit they run,
  /// anything the office needs to see beside the name. Never shown to the sub.
  notes          String            @default("")
  since          String            @default("")

  // ---- Vendor packet -------------------------------------------------------
  // What any contractor asks for before letting a crew on site. The sub fills
  // this in from their own portal; Fortitude reviews it.

  /// Legal entity name as it appears on the W-9 — often not the trading name.
  legalName            String @default("")
  dba                  String @default("")
  /// LLC / S-Corp / C-Corp / Partnership / Sole proprietor.
  entityType           String @default("")
  stateOfIncorporation String @default("")
  /// Federal EIN. Sensitive: it is on the W-9 we already hold, and it is the
  /// one field here that is worth stealing on its own.
  ein                  String @default("")
  website              String @default("")

  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  stateRegion  String @default("")
  postalCode   String @default("")

  /// Who signs contracts, and who chases payment — rarely the same person.
  signatoryName  String @default("")
  signatoryTitle String @default("")
  apContactName  String @default("")
  apEmail        String @default("")
  apPhone        String @default("")

  mobilePhone           String @default("")
  emergencyContactName  String @default("")
  emergencyContactPhone String @default("")

  /// The billing representative the agreement requires — every invoice, daily,
  /// as-built and payment query goes through this person.
  billingContactName    String @default("")
  billingContactTitle   String @default("")
  billingEmail          String @default("")
  billingMobile         String @default("")
  billingOfficePhone    String @default("")
  billingMailingAddress String @default("")

  paymentMethod   String @default("")
  paymentTerms    String @default("Net 21")
  remittanceEmail String @default("")

  contractorLicense String @default("")
  dotNumber         String @default("")
  locateCert        String @default("")

  /// Experience modification rate — the number a GC's insurer asks for first.
  emr             Float?
  oshaRecordables Int?
  safetyContact   String @default("")

  /// Two or three GCs they've worked for, as [{company, contact, phone, email}].
  references Json @default("[]")

  users     User[]
  contacts  CrewContact[]
  documents SubDocument[]
  rates     SubcontractorRate[]
  contracts Document[]
  locateTickets     LocateTicket[]
  contractorLocates ContractorLocate[]
  createdAt DateTime            @default(now())
}

/// A file a subcontractor uploads to an onboarding/compliance section. Stored as
/// a data URL so it's downloadable without external blob storage (pilot).
model SubDocument {
  id              String        @id @default(cuid())
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  section         String
  fileName        String
  mediaType       String        @default("")
  sizeBytes       Int           @default(0)
  dataUrl         String
  uploadedBy      String        @default("subcontractor")
  createdAt       DateTime      @default(now())
}

/// Where a crew's pay statement stands.
/// How a statement settles. A crew does not choose this — standard pay runs
/// on the ACH details they gave at onboarding, and fast pay goes by wire.
enum PayMethod {
  ACH
  WIRE
}

enum SubInvoiceStatus {
  /// Building as their dailies are approved.
  DRAFT
  /// Sent to the crew, waiting on them.
  ISSUED
  /// The crew agreed the figures. Timestamped.
  ACCEPTED
  /// The crew says something is wrong, with a reason.
  DISPUTED
  PAID
  VOID
}

/// What Fortitude owes one crew for one week on one job.
///
/// The mirror of the customer invoice, and deliberately a separate record: the
/// customer's is what we bill, this is what the work costs, and the difference
/// between them is our margin. Sharing a table would put a crew one query away
/// from the number they must never see.
///
/// Priced at the crew's own signed card, at the rate in force on the work date.
model SubInvoice {
  id              String           @id @default(cuid())
  number          String           @unique
  subcontractor   Subcontractor    @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId       String?
  projectName     String           @default("")
  periodStart     String           @default("")
  periodEnd       String           @default("")
  status          SubInvoiceStatus @default(DRAFT)
  /// What we owe, from the lines. Frozen once issued.
  subtotal        Float            @default(0)

  /// Retainage, held back at the rate Fortitude is held back on that job.
  ///
  /// Frozen onto the statement rather than read from the customer each time
  /// it is displayed: the rate on the job can be renegotiated, and a crew who
  /// accepted a figure in August must still see that figure in December.
  retainagePct    Float            @default(0)
  retainageHeld   Float            @default(0)
  issuedAt        DateTime?

  /// The record of them agreeing: who, and exactly when.
  acceptedAt  DateTime?
  acceptedBy  String    @default("")
  /// Their reason when they don't agree — required, because "denied" alone
  /// tells the office nothing to act on.
  disputeNote String    @default("")
  disputedAt  DateTime?
  disputedBy  String    @default("")

  /// Settlement window in calendar days. 21 unless fast pay is elected,
  /// which takes it to 10.
  termsDays Int @default(21)

  /// Fast pay — the crew trades a slice of the statement for getting paid
  /// sooner. Wire only, and that is not a preference they set: wire is what
  /// actually clears inside ten days.
  fastPay          Boolean   @default(false)
  /// Fee percentage, frozen at the moment it is elected. A house rate changed
  /// next quarter must not restate a statement somebody already agreed to.
  fastPayFeePct    Float     @default(0)
  fastPayElectedAt DateTime?
  fastPayElectedBy String    @default("")
  /// How this settles. Electing fast pay forces WIRE.
  payMethod        PayMethod @default(ACH)

  /// Fortitude's note back, when a dispute is settled.
  resolutionNote String           @default("")
  lines          SubInvoiceLine[]
  payments       SubPayment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([subcontractorId, status])
  @@index([projectId])
}

/// One priced unit of a crew's own production.
///
/// The rate lives on the line rather than being looked up, so a card edited in
/// March cannot restate what a crew already accepted in January.
model SubInvoiceLine {
  id          String     @id @default(cuid())
  invoice     SubInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  /// The daily this came from. A plain id — deleting a daily must not silently
  /// remove a line from a statement a crew has accepted.
  dailyId     String     @default("")
  workDate    String     @default("")
  code        String     @default("")
  description String     @default("")
  unit        String     @default("")
  quantity    Float      @default(0)
  rate        Float      @default(0)
  amount      Float      @default(0)
  /// Produced by a rule rather than written on a sheet. See InvoiceLine.
  derived     Boolean    @default(false)

  /// Which rate card priced this line, recorded when it was priced. A crew is
  /// paid from a signed card, and "which card was that" is the first question
  /// asked when a figure is disputed — reading it back off the card today
  /// answers what the card says now, not what it said when this was priced.
  sourceCard String @default("")

  @@index([invoiceId])
  @@index([dailyId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  /// Waiting on somebody or something else. Carries a reason.
  BLOCKED
  DONE
  CANCELLED
}

/// What kind of thing a task is.
///
/// Not a label for tidiness — it is what tells somebody scanning the list
/// whether this is paperwork or a hole in the ground before they read the
/// title. A lapsed COI and a damaged flowerpot need different people and
/// different urgency, and they read identically without this.
enum TaskCategory {
  /// Insurance, licences, packets — paperwork that blocks work.
  COMPLIANCE
  /// Something wrong on the ground: damage, a rework, a miss.
  FIELD_ISSUE
  /// Material to move, order, return or count.
  MATERIALS
  /// Somebody could get hurt.
  SAFETY
  /// Billing, invoicing, the office.
  ADMIN
  /// Everything that is none of the above rather than a wrong guess.
  GENERAL
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A piece of work assigned to one person or one crew.
///
/// The assignee is either an employee or a subcontractor, never both and never
/// neither once assigned — "the office" owning a task is how it ends up owned
/// by nobody. Two nullable columns rather than one polymorphic id, so the
/// database can still enforce that each points at something real.
///
/// Deliberately not a project requirement: half of what needs chasing (a COI, a
/// rate card, a truck) belongs to no job at all.
model Task {
  conversations Conversation[]
  id       String       @id @default(cuid())
  title    String
  detail   String       @default("")
  status   TaskStatus   @default(OPEN)
  priority TaskPriority @default(NORMAL)
  category TaskCategory @default(GENERAL)
  /// YYYY-MM-DD. Blank means no date, which is different from overdue.
  dueDate  String       @default("")

  /// An employee.
  assigneeUser   User?          @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeUserId String?
  /// Or a crew — the company, so it survives their staff changing.
  assigneeSub    Subcontractor? @relation("TaskCrew", fields: [assigneeSubId], references: [id], onDelete: SetNull)
  assigneeSubId  String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  createdByEmail String    @default("")
  /// Set when it reaches DONE, and cleared if it is reopened.
  completedAt    DateTime?
  completedBy    String    @default("")
  /// Why it is blocked, or why it was cancelled.
  statusNote     String    @default("")

  photos   TaskPhoto[]
  comments TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeUserId, status])
  @@index([assigneeSubId, status])
  @@index([projectId])
}

/// A photograph attached to a task.
///
/// Two kinds, and the distinction is the point: PROBLEM is what somebody found,
/// RESOLUTION is what was done about it. A task closed with a photo of the fix
/// beside the photo of the fault settles an argument that words never will.
///
/// These go to Blob like project photos — a picture of a cracked pedestal is
/// not a Social Security card, and the trade-off that makes badge documents
/// database-only does not apply.
model TaskPhoto {
  id             String   @id @default(cuid())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  url            String
  mediaType      String   @default("")
  sizeBytes      Int      @default(0)
  /// PROBLEM | RESOLUTION
  kind           String   @default("PROBLEM")
  caption        String   @default("")
  /// Where it was taken, when the device gave a position. Same honesty as the
  /// project gallery: a coordinate is stored only with a source behind it.
  lat            Float?
  lng            Float?
  locationSource String   @default("")
  uploadedBy     String   @default("")
  createdAt      DateTime @default(now())

  @@index([taskId])
}

/// A note on a task — the thread that turns an instruction into a conversation.
///
/// Status changes are written here too, so the history reads in one column
/// rather than being split between what was said and what was done.
model TaskComment {
  id          String   @id @default(cuid())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  body        String
  /// True when the row records a status change rather than something typed.
  systemNote  Boolean  @default(false)
  authorName  String   @default("")
  authorEmail String   @default("")
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Who looked at something sensitive, and when.
///
/// The interesting question about a bank account number is never "what is it"
/// but "who read it". Decryption is the moment worth recording, so it is
/// recorded — and kept separate from the record it concerns, so removing a
/// crew does not remove the history of who accessed their details.
model AccessLog {
  id          String   @id @default(cuid())
  /// Dotted, e.g. "ach.revealed".
  action      String
  actorUserId String   @default("")
  actorEmail  String   @default("")
  /// What was accessed, in words — this is read by a person, not a query.
  detail      String   @default("")
  subjectId   String   @default("")
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([subjectId])
}

/// A signed ACH authorisation — the crew telling us where to send their money.
///
/// One per subcontractor: a company has one place it gets paid, and allowing
/// several would mean choosing between them at payment time, which is exactly
/// the decision nobody wants to make by hand. Replacing it supersedes the old
/// one, and the signature and date move with it.
///
/// The account and routing numbers are encrypted at rest and never leave the
/// server in the clear — see src/lib/field-crypto.ts. Everything else here is
/// ordinary business information and stays queryable.
model AchAuthorization {
  id              String        @id @default(cuid())
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String        @unique

  // Who is being paid. Repeated from the vendor packet rather than referenced,
  // because this is a signed instrument: it has to say what it said on the day,
  // even if the packet is edited afterwards.
  legalName    String @default("")
  dba          String @default("")
  ein          String @default("")
  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  stateRegion  String @default("")
  postalCode   String @default("")
  phone        String @default("")
  email        String @default("")

  // Where the money goes.
  bankName         String @default("")
  bankAddressLine1 String @default("")
  bankCity         String @default("")
  bankStateRegion  String @default("")
  bankPostalCode   String @default("")
  /// "checking" | "savings"
  accountType      String @default("checking")
  /// AES-256-GCM ciphertext. Never sent to a client.
  accountNumberEnc String @default("")
  routingNumberEnc String @default("")
  /// Shown instead of the real thing, and enough to reconcile a remittance.
  accountLast4     String @default("")
  routingLast4     String @default("")

  // The authorisation itself.
  signerName       String    @default("")
  signerTitle      String    @default("")
  /// Drawn signature as a data URL.
  signatureDataUrl String    @default("")
  /// The date the signer put on it, as YYYY-MM-DD.
  signedDate       String    @default("")
  /// When the form was actually submitted — distinct from the date typed on it.
  submittedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BadgeStatus {
  /// The crew is still uploading.
  DRAFT
  /// Sent to Fortitude, waiting on a decision.
  SUBMITTED
  /// Cleared to collect material.
  APPROVED
  REJECTED
  /// Was cleared, no longer is.
  REVOKED
}

enum BadgeDocKind {
  LICENSE_FRONT
  LICENSE_BACK
  SSN_CARD
  PASSPORT
}

/// One named person cleared to collect material from the yard.
///
/// A badge is per person, not per company: the yard needs to know that the man
/// in front of them is the man on the list, which is why it carries a photo ID
/// and not just a company name.
model CrewBadge {
  id              String          @id @default(cuid())
  subcontractor   Subcontractor   @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  personName      String
  phone           String          @default("")
  status          BadgeStatus     @default(DRAFT)
  /// Licence expiry as YYYY-MM-DD. A badge stops being valid when the licence
  /// behind it does, which nobody remembers to check by hand.
  licenseExpires  String          @default("")
  reviewNote      String          @default("")
  reviewedBy      String          @default("")
  reviewedAt      DateTime?
  documents       BadgeDocument[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([subcontractorId, status])
}

/// A photo of an identity document, held for badge verification.
///
/// Deliberately stored in the database rather than object storage. The Blob
/// store this app uses elsewhere is public-read — unguessable URLs and no
/// access control — which is an acceptable trade for a photograph of a
/// pedestal and an unacceptable one for somebody's Social Security card or
/// passport. Here the row is only ever reachable through a query that has
/// already checked who is asking.
///
/// One document per kind per badge: re-uploading a licence front replaces it,
/// so an expired image cannot sit alongside its replacement.
model BadgeDocument {
  id         String       @id @default(cuid())
  badge      CrewBadge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId    String
  kind       BadgeDocKind
  fileName   String
  mediaType  String       @default("")
  sizeBytes  Int          @default(0)
  dataUrl    String
  uploadedBy String       @default("")
  createdAt  DateTime     @default(now())

  @@unique([badgeId, kind])
  @@index([badgeId])
}

model Daily {
  id            String   @id @default(cuid())
  sheetNumber   String   @default("")
  project       Project? @relation(fields: [projectId], references: [id])
  projectId     String?
  projectName   String   @default("")
  customer      String   @default("")
  subcontractor String   @default("")
  crew          String   @default("")

  /// The road or roads the day's work was on — "Keener Rd", "Hwy 17 to
  /// Pierce Creek".
  ///
  /// Free text, because a day's work runs along a road rather than sitting
  /// at a point, and the crew already say it that way on the phone. It is
  /// the fastest way to tell two of the same job's dailies apart in a list
  /// where every row says the same project, crew and work order.
  roads            String            @default("")
  workDate      String   @default("")

  /// Administration override for which billing week this daily falls in, as
  /// the Friday that closes that week. Empty means derive it from workDate,
  /// which is the rule: Saturday through Friday, and anything after Friday
  /// night belongs to the week that follows. The override exists because the
  /// office sometimes has to hold a day back or pull one forward, and doing
  /// that by editing the work date would falsify when the work happened.
  billingWeekEnd String   @default("")
  /// Set when that Friday came from missing the cutoff rather than from the
  /// office moving the day. Two different reasons a daily is not on the week
  /// you would expect, and a crew is owed the difference between them.
  billingWeekLate Boolean @default(false)
  submittedAt    String   @default("")
  status         String   @default("Submitted")
  tone           String   @default("info")
  totalFt        Int      @default(0)
  billableAmount Int      @default(0)
  lineItems      Json     @default("[]")
  photos         Int      @default(0)
  hasAsBuilt     Boolean  @default(false)
  hasBoreLog     Boolean  @default(false)
  flags          Json     @default("[]")
  /// Supervisor review. A denial without a reason is useless to the crew that
  /// has to fix it, so the note is required when denying.
  reviewNote     String   @default("")
  reviewedBy     String   @default("")
  reviewedAt     String   @default("")
  createdAt      DateTime @default(now())
}

/// Where an invoice stands. DRAFT is staged and still recomputable; everything
/// from SENT on is a figure the customer has seen, and is frozen.
enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

/// A week's approved dailies, priced and sent as one bill.
///
/// Each daily is its own priced line group — that is how the work is approved
/// and how a dispute gets settled — but they leave together on a weekly cutoff
/// because that is what the customer's billing calendar expects.
///
/// The money columns are written once, at issue, from the rate card as it stood
/// that day. They are never recomputed. A rate card edited in March must not
/// silently restate a January invoice the customer has already paid.
model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     String?
  /// Denormalised so the invoice still reads if the project is renamed.
  projectName   String        @default("")
  /// Inclusive weekly cutoff this batch covers, as YYYY-MM-DD.
  periodStart   String        @default("")
  periodEnd     String        @default("")
  status        InvoiceStatus @default(DRAFT)
  /// Work priced at the customer's card.
  subtotal      Float         @default(0)
  /// Held back per the contract, captured at issue so a later change to the
  /// customer's terms cannot restate what was withheld on an old invoice.
  retainagePct  Float         @default(0)
  retainageHeld Float         @default(0)
  /// subtotal - retainageHeld. What the customer actually owes on this bill.
  amountDue     Float         @default(0)
  issuedAt      DateTime?
  dueAt         DateTime?
  voidedAt      DateTime?
  voidReason    String        @default("")
  notes         String        @default("")
  lines         InvoiceLine[]
  payments      Payment[]
  createdAt     DateTime      @default(now())

  @@index([customerId, status])
  @@index([projectId])
}

/// One priced unit code on an invoice, carrying the daily it came from.
///
/// The rate is stored on the line rather than looked up, for the same reason
/// the totals are: this is the number the customer was billed, not the number
/// the card happens to say today.
/// A billed unit.  marks a line a rule produced rather than a person
/// wrote — the microduct depth adder — so a figure nobody typed can always be
/// explained when a customer asks where it came from.
model InvoiceLine {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  /// The daily this production was reported on. Kept as a plain id — deleting
  /// a daily must not quietly delete a line off a sent invoice.
  dailyId     String  @default("")
  workDate    String  @default("")
  code        String  @default("")
  description String  @default("")
  unit        String  @default("")
  quantity    Float   @default(0)
  rate        Float   @default(0)
  amount      Float   @default(0)
  derived     Boolean @default(false)

  @@index([invoiceId])
  @@index([dailyId])
}

/// Money actually received against an invoice.
///
/// Recorded by hand from the bank or the remittance advice. Partial payments
/// are normal on this work, so an invoice is only PAID once the payments cover
/// it — nothing infers payment from an invoice merely being old.
model Payment {
  id         String   @id @default(cuid())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  amount     Float    @default(0)
  /// Date the money landed, as YYYY-MM-DD — the bank's date, not today's.
  receivedOn String   @default("")
  method     String   @default("")
  reference  String   @default("")
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([invoiceId])
}

/// What we expect to pay on one job, before a crew is chosen.
///
/// A job has to be priceable the day the material list lands, which is long
/// before anyone is assigned to it. These are the budgeted rates: the cost side
/// of the valuation falls back to them when no assigned crew has a signed card,
/// so a margin exists to decide on rather than a row of dashes.
///
/// Deliberately separate from SubcontractorRate. That table is what a specific
/// company signed and is what they get paid; this is a plan. Merging them would
/// let a budget figure quietly become the number on an invoice.
model ProjectRate {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  code        String
  description String   @default("")
  unit        String   @default("")
  rate        Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([projectId, code])
  @@index([projectId])
}

/// Where a photo's time and place came from.
///
/// This is the difference between a record and a story. A photo taken through
/// the app carries the device's own position at the moment of capture. A photo
/// chosen from the library was taken somewhere else, at some other time, and
/// stamping it with where the phone is *now* would manufacture evidence — so
/// its location comes from the file's own EXIF or it has none at all.
enum CaptureSource {
  CAMERA
  LIBRARY
}

/// A field photo or video on a project — evidence, and direction for the crew.
///
/// Two jobs in one record. As-built evidence has to be defensible: what was
/// built, where, and when, in a form that settles a dispute months later. A
/// direction shot is the opposite — it points a crew at a specific spot before
/// the work happens. Same capture path, different intent, so `purpose` says
/// which rather than leaving a gallery nobody can search.
model ProjectPhoto {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  /// Blob URL. Unguessable, but the store is public-read — fine for a job-site
  /// photo, and the reason contracts do not live here.
  url       String
  mediaType String  @default("")
  sizeBytes Int     @default(0)
  /// PHOTO | VIDEO
  kind      String  @default("PHOTO")

  source CaptureSource @default(LIBRARY)

  /// When the shutter fired, as distinct from when the file was uploaded —
  /// a crew photographing yesterday's work today is normal, and createdAt
  /// would quietly date the evidence wrong.
  capturedAt       DateTime?
  /// "camera" | "exif" | "file" — how capturedAt was established, so a weak
  /// source is visible rather than presented with the same authority as a
  /// real one.
  capturedAtSource String    @default("")

  lat            Float?
  lng            Float?
  /// Metres of uncertainty the device reported. A 2,000 m fix is a cell-tower
  /// guess and should not be drawn on a map like a survey point.
  accuracyM      Float?
  /// "device" | "exif" — never inferred, never filled in from the project.
  locationSource String @default("")

  caption String @default("")
  /// RECORD (evidence of work) | DIRECTION (instruction for the crew)
  purpose String @default("RECORD")

  uploadedBy String   @default("")
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

/// One project-specific onboarding invite link.
model Invite {
  token           String   @id
  projectId       String?
  projectName     String   @default("")
  customer        String   @default("")
  email           String?
  used            Boolean  @default(false)
  /// The subcontractor this invite created, once they start onboarding.
  ///
  /// This is what authorizes the rest of the flow. Onboarding legitimately runs
  /// before anyone has a login, so the actions that write to a subcontractor
  /// cannot demand a session — but they can demand the token that made this
  /// record, which binds a caller to one company and no other. Without it, an
  /// action taking a subcontractor id would let anyone write into any sub's
  /// file, including uploading documents into a competitor's packet.
  subcontractorId String?
  createdAt       DateTime @default(now())

  @@index([subcontractorId])
}

/// Feedback from the pilot account.
model Feedback {
  id        String   @id @default(cuid())
  category  String   @default("idea")
  message   String
  fromName  String?
  fromEmail String?
  page      String?
  createdAt DateTime @default(now())
}

enum RateDocType {
  GC_RATE_SHEET
  UNIT_DESCRIPTION
  MATERIAL_LIST
  SUB_RATE_CARD
}

enum ImportStatus {
  PROCESSING
  EXTRACTED
  APPROVED
  REJECTED
  FAILED
}

enum RowStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One uploaded rate/unit/material/rate-card document + its extraction job.
model RateImport {
  id            String         @id @default(cuid())
  docType       RateDocType
  /// The file as it arrived. Kept even after somebody renames the import —
  /// it is what the document is actually called, and the only way back to it
  /// when a name typed months later stops matching anything.
  fileName      String
  /// What the office calls it. Empty means nobody has renamed it, and the
  /// file name stands in — not a copy of it, so a rename can be undone by
  /// clearing this rather than by remembering the original.
  displayName   String         @default("")
  mediaType     String         @default("")
  status        ImportStatus   @default(PROCESSING)
  // Optional scoping the user provides at upload.
  customer      String         @default("")
  market        String         @default("")
  /// Free-text project label from the rate-import screen. When the import was
  /// started from a project page, `projectId` below is the authoritative link —
  /// this stays populated so renaming a project doesn't lose the label.
  project       String         @default("")
  linkedProject Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     String?
  summary       String         @default("")
  error         String         @default("")
  rows          ExtractedRow[]
  createdAt     DateTime       @default(now())
}

/// One extracted line item, kept as a reviewable draft until approved. The full
/// per-doc-type field set lives in `data`; the columns below drive the review UI.
model ExtractedRow {
  id          String     @id @default(cuid())
  import      RateImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  importId    String
  code        String     @default("")
  description String     @default("")
  unit        String     @default("")
  rate        Float?
  minimum     Float?
  rules       String     @default("")
  sourcePage  String     @default("")
  confidence  Float      @default(0)
  matchStatus String     @default("new")
  warning     String     @default("")
  status      RowStatus  @default(PENDING)
  data        Json       @default("{}")
  createdAt   DateTime   @default(now())
}

/**
 * ================================================================== *
 * Document Intelligence Center
 * A document is structured content, not a file. A version holds the
 * editor tree plus the variable values and clause versions resolved at
 * render time; the PDF is an output. That is what makes versioning,
 * diffing and comparison possible — a stack of PDFs cannot be diffed.
 * Executed versions are immutable. Corrections create a new version or
 * an amendment that supersedes; nothing overwrites signed history.
 * ==================================================================
 */

enum DocType {
  NDA
  MASTER_SUBCONTRACTOR_AGREEMENT
  PROJECT_SUBCONTRACTOR_AGREEMENT
  SUBCONTRACTOR_RATE_CARD
  CHANGE_ORDER
  PURCHASE_ORDER
  CUSTOMER_CONTRACT
  WORK_AUTHORIZATION
  INSURANCE_REQUEST
  W9_REQUEST
  LIEN_WAIVER
  SAFETY_FORM
  EMPLOYMENT_DOCUMENT
  VENDOR_AGREEMENT
  CLOSEOUT
  CUSTOM
}

enum DocStatus {
  DRAFT
  INTERNAL_REVIEW
  CHANGES_REQUESTED
  APPROVED
  READY_TO_SEND
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  EXECUTED
  EXPIRED
  SUPERSEDED
  ARCHIVED
  VOIDED
}

enum ApprovalStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

/// A reusable starting point. Holds slots; the resolver fills them.
model DocumentTemplate {
  id             String              @id @default(cuid())
  name           String
  type           DocType             @default(CUSTOM)
  category       String              @default("")
  description    String              @default("")
  /// Editor tree with variable slots and clause anchors.
  bodyJson       Json                @default("{}")
  version        Int                 @default(1)
  active         Boolean             @default(true)
  approvalStatus ApprovalStatus      @default(NOT_REQUESTED)
  approvedBy     String?
  approvedAt     DateTime?
  supersedesId   String?
  createdBy      String              @default("")
  documents      Document[]
  conditions     TemplateCondition[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([type, active])
}

/// A variable a template can reference. sourcePath is how it resolves
/// against live data, e.g. "subcontractor.legalName" or "project.number".
model TemplateVariable {
  id         String   @id @default(cuid())
  key        String   @unique
  label      String
  sourcePath String   @default("")
  kind       String   @default("text")
  /// Custom variables are author-defined; built-ins ship with the app.
  custom     Boolean  @default(false)
  sample     String   @default("")
  createdAt  DateTime @default(now())
}

/// "If project state is Georgia, insert the Georgia governing-law clause."
model TemplateCondition {
  id         String           @id @default(cuid())
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  /// Structured predicate, evaluated server-side. Never eval'd as code.
  expression Json             @default("{}")
  clause     Clause?          @relation(fields: [clauseId], references: [id])
  clauseId   String?
  sectionKey String           @default("")
  order      Int              @default(0)

  @@index([templateId])
}

/// A versioned block of contract language.
model Clause {
  id             String              @id @default(cuid())
  name           String
  category       String              @default("")
  body           String              @default("")
  version        Int                 @default(1)
  effectiveDate  String              @default("")
  /// Empty means "applies everywhere" for both of these.
  states         String[]            @default([])
  customerIds    String[]            @default([])
  active         Boolean             @default(true)
  approvalStatus ApprovalStatus      @default(NOT_REQUESTED)
  supersedesId   String?
  createdBy      String              @default("")
  conditions     TemplateCondition[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([category, active])
}

model Document {
  id               String            @id @default(cuid())
  type             DocType           @default(CUSTOM)
  title            String
  status           DocStatus         @default(DRAFT)
  /// Pointer to the version currently in force. Never deleted.
  currentVersionId String?
  template         DocumentTemplate? @relation(fields: [templateId], references: [id])
  templateId       String?

  customer        Customer?      @relation(fields: [customerId], references: [id])
  customerId      String?
  project         Project?       @relation(fields: [projectId], references: [id])
  projectId       String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id])
  subcontractorId String?
  rateCardId      String?
  dailyId         String?
  invoiceId       String?

  effectiveDate  String @default("")
  expirationDate String @default("")

  ownerId      String    @default("")
  createdBy    String    @default("")
  /// When this document was replaced by a newer agreement.
  supersedesId String?
  archivedAt   DateTime?
  /// Soft delete — legal records are never hard-deleted.
  deletedAt    DateTime?

  versions   DocumentVersion[]
  files      DocumentFile[]
  access     DocumentAccess[]
  favorites  DocumentFavorite[]
  auditTrail DocumentAuditEvent[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status])
  @@index([type])
  @@index([projectId])
  @@index([subcontractorId])
  @@index([customerId])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  versionNo  Int

  /// The editable content — the source of truth, not the PDF.
  bodyJson          Json @default("{}")
  /// What the variables resolved to when this version was rendered, so an
  /// executed document still reads correctly after the source data moves on.
  variablesSnapshot Json @default("{}")
  /// Which clause versions were used, for the same reason.
  clausesSnapshot   Json @default("[]")

  changeReason    String         @default("")
  changedSections String[]       @default([])
  approvalStatus  ApprovalStatus @default(NOT_REQUESTED)
  approvedBy      String?
  approvedAt      DateTime?

  /// SHA-256 of the rendered PDF, so a signature binds to exact content.
  checksum  String  @default("")
  pdfFileId String?

  /// Set the moment the document executes. A locked version is immutable.
  lockedAt  DateTime?
  createdBy String    @default("")
  createdAt DateTime  @default(now())

  fields   DocumentField[]
  comments DocumentComment[]

  @@unique([documentId, versionNo])
  @@index([documentId])
}

/// A placed field on a page — where a signer signs, dates or fills in.
model DocumentField {
  id        String          @id @default(cuid())
  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId String
  kind      String          @default("text")
  page      Int             @default(1)
  x         Float           @default(0)
  y         Float           @default(0)
  w         Float           @default(0)
  h         Float           @default(0)
  /// Which signer must complete it; null means an internal fill-in.
  signerId  String?
  required  Boolean         @default(true)
  label     String          @default("")
  value     String          @default("")
  options   String[]        @default([])
  sortOrder Int             @default(0)

  @@index([versionId])
}

/// A stored object. Originals and generated files are kept apart so an
/// upload is never overwritten by a render.
model DocumentFile {
  id         String    @id @default(cuid())
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String?
  versionId  String?
  /// original_upload | generated_pdf | executed_pdf | audit_certificate |
  /// signature_image | attachment
  kind       String    @default("attachment")
  storageKey String
  fileName   String    @default("")
  mime       String    @default("")
  sizeBytes  Int       @default(0)
  checksum   String    @default("")
  scanStatus String    @default("pending")
  uploadedBy String    @default("")
  createdAt  DateTime  @default(now())

  @@index([documentId])
}

model DocumentComment {
  id         String          @id @default(cuid())
  version    DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId  String
  anchor     String          @default("")
  body       String
  /// Internal notes are never visible to a subcontractor.
  internal   Boolean         @default(true)
  authorId   String          @default("")
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([versionId])
}

/// An explicit share. A crew sees a document because of a row here or
/// because it is addressed to their company — never by guessing an id.
model DocumentAccess {
  id              String   @id @default(cuid())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId      String
  subcontractorId String?
  userId          String?
  canView         Boolean  @default(true)
  canSign         Boolean  @default(false)
  sharedBy        String   @default("")
  createdAt       DateTime @default(now())

  @@index([documentId])
  @@index([subcontractorId])
}

model DocumentFavorite {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  userId     String
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
}

/// Append-only. Every action that touches a document lands here.
model DocumentAuditEvent {
  id          String   @id @default(cuid())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String
  versionId   String?
  action      String
  actorUserId String?
  actorEmail  String   @default("")
  detail      Json     @default("{}")
  ip          String   @default("")
  userAgent   String   @default("")
  at          DateTime @default(now())

  @@index([documentId, at])
}

/**
 * ------------------------------------------------------------------------- *
 * Prospects — the pipeline before anybody is on a job.
 * Three different relationships share one table because the office works them
 * the same way: find them, talk to them, decide. What differs is the direction
 * of the money. A WORKER or a CREW is somebody Fortitude would pay; a PRIME is
 * somebody who would pay Fortitude. Keeping them together means one list of
 * "who do we know in this state", which is the question that actually gets
 * asked when a job comes up somewhere new.
 * -------------------------------------------------------------------------
 */

enum ProspectKind {
  /// An individual — operator, laborer, fusion tech — hired directly.
  WORKER
  /// A crew company that could run production under Fortitude.
  SUBCONTRACTOR
  /// A general or prime contractor Fortitude would work for. Future business.
  PRIME
}

/// How far along a conversation is. LOST and DORMANT are kept apart on
/// purpose: lost is a decision, dormant is a phone number worth trying again.
enum ProspectStage {
  NEW
  CONTACTED
  QUALIFYING
  IN_DISCUSSION
  /// Terms being agreed. Between discussion and ready.
  NEGOTIATING
  /// Everything a crew needs is in; onboarding is the next act.
  READY_TO_ONBOARD
  WON
  LOST
  DORMANT
  /// Deliberately never again, with a reason on the record.
  DO_NOT_USE

  /// Prime-side stages. A prime is not recruited, it is pursued, and forcing
  /// a crew pipeline onto one made every prime sit in "Qualifying" forever.
  VENDOR_REGISTRATION
  PREQUALIFIED
  BID_SUBMITTED
}

/// Whether somebody can start.
enum ProspectAvailability {
  UNKNOWN
  AVAILABLE_NOW
  AVAILABLE_SOON
  LIMITED
  COMMITTED
  UNAVAILABLE
}

model Prospect {
  id    String        @id @default(cuid())
  kind  ProspectKind
  stage ProspectStage @default(NEW)

  /// Company name, or the person's name when this is a worker.
  name        String
  contactName String @default("")
  contactRole String @default("")
  email       String @default("")
  phone       String @default("")
  website     String @default("")

  /// Where they are based.
  city      String   @default("")
  homeState String   @default("")
  /// States they will actually travel to or hold work in. A prospect based in
  /// one state who works four is the normal case, not the exception.
  states    String[] @default([])
  /// Named markets — "Greenville-Spartanburg", "Atlanta Metro". For a prime,
  /// these are the markets they hold; for a crew, where they want work.
  markets   String[] @default([])

  trades    String[] @default([])
  crewSize  Int      @default(0)
  equipment String[] @default([])

  /// 0 = unrated. Gut-feel ranking so the good ones stay findable.
  rating Int    @default(0)
  /// Referral, jobsite, cold call — worth knowing which channels work.
  source String @default("")
  notes  String @default("")

  /// The single next thing somebody has to do, and by when. A pipeline without
  /// this is just a list of names.
  nextStep    String @default("")
  nextStepDue String @default("")
  lastContact String @default("")
  owner       String @default("")

  /// Who owns the relationship, as an account rather than a typed name — a
  /// pipeline filtered by "Sean" and a pipeline filtered by "sean" are two
  /// different pipelines.
  ownerUser   User?   @relation("ProspectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerUserId String?

  availability      ProspectAvailability @default(UNKNOWN)
  /// How many of their crews could start, and when the first one could.
  availableCrews    Int      @default(0)
  earliestStart     String   @default("")
  yearsInBusiness   Int      @default(0)
  /// How far they will travel, and what it costs to move them.
  travelRadiusMiles Int      @default(0)
  perDiemRequired   Boolean  @default(false)
  lodgingRequired   Boolean  @default(false)

  /// When the prospect entered the stage it is in. A prospect sitting in
  /// discussion for thirty-one days is the thing worth seeing, and an
  /// updatedAt that moves every time somebody adds a note cannot show it.
  stageEnteredAt DateTime @default(now())

  /// Why it stopped. Kept when a prospect is reactivated, because the reason
  /// it went cold is exactly what the next person needs to read.
  closedReason String @default("")
  closedNote   String @default("")

  /// Flagged as a likely duplicate of another record. Never merged
  /// automatically — a merge that guesses wrong destroys two histories.
  duplicateOfId String?

  /// Set when a won crew is promoted into the real subcontractor roster, so
  /// the pipeline keeps its history instead of the record vanishing.
  convertedSubcontractorId String?
  convertedCustomerId      String?
  convertedAt              DateTime?

  contacts       ProspectContact[]
  equipmentItems ProspectEquipment[]
  capabilities   ProspectCapability[]
  rates          ProspectRate[]
  availabilityLog ProspectAvailabilityEntry[]
  qualifications ProspectQualification[]
  references     ProspectReference[]
  opportunities  ProspectOpportunity[]

  activities ProspectActivity[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([kind, stage])
  @@index([homeState])
  @@index([ownerUserId])
  @@index([availability])
  @@index([nextStepDue])
  @@index([stage, stageEnteredAt])
  @@index([name])
}

/// One logged touch — a call, an email, a note, or a stage change.
model ProspectActivity {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  /// note | call | email | meeting | stage
  kind       String   @default("note")
  body       String   @default("")
  author     String   @default("")
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

/// Who a notification is for.
///
/// Not a preference — a boundary. Staff notifications name crews, jobs and
/// money across the whole book; a crew's name what happened to their own work.
/// The two are never the same row, so there is no filter to get wrong.
enum NotifyAudience {
  STAFF
  SUBCONTRACTOR
}

/// Something that happened which somebody should know about.
///
/// Written at the moment of the event rather than derived by polling, so the
/// record says what happened and when, and a notification cannot quietly
/// change its mind later because the underlying row moved on.
model Notification {
  id              String         @id @default(cuid())
  audience        NotifyAudience
  /// Set when the audience is one crew. Null for the office.
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String?

  title    String
  detail   String @default("")
  /// Where to go to act on it.
  href     String @default("")
  /// daily | billing | compliance | crew | system
  category String @default("system")
  tone     String @default("info")

  /// Who did the thing, for the office to see at a glance.
  actor String @default("")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([audience, subcontractorId, readAt])
  @@index([createdAt])
}

/// What a utility member said about a ticket.
///
/// UNKNOWN is a real state and the default: a member who has not answered is
/// not a member who has cleared. That distinction is the whole reason for
/// recording responses one by one rather than marking a ticket "done".
enum LocateResponseStatus {
  MARKED
  CLEAR
  NOT_COMPLETE
  DELAYED
  UNKNOWN
}

/// A Georgia 811 locate ticket.
///
/// Dates are held as YYYY-MM-DD because a ticket expires on a day, not at a
/// moment, and storing a timestamp invites a timezone to move it. The expiry
/// and update-by dates are stored as 811 stated them where known; blank means
/// nobody has said, and the app computes a fallback and labels it as computed.
model LocateTicket {
  id       String @id @default(cuid())
  number   String
  /// 811 re-issues under the same number with a revision.
  revision String @default("")

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  street      String @default("")
  crossStreet String @default("")
  city        String @default("")
  county      String @default("")
  /// What the ticket says the work is — bore, trench, plow.
  workType    String @default("")
  /// NORMAL | CANCEL | UPDATE | EMERGENCY | RETRANSMIT, as stated. A cancel
  /// ticket is not a locate: it withdraws one, and must never read as in force.
  ticketType  String @default("")
  /// The text this was read from, kept so a misread can be diagnosed against
  /// what actually arrived rather than against a memory of it.
  sourceText  String @default("")

  /// The clock. All calendar days.
  calledInOn    String @default("")
  /// "Effective On" — the ticket is not in force before this.
  workToBeginOn String @default("")
  /// "Response By" — when the members owe an answer. Past this with silence
  /// is a call to make, not a wait to keep having.
  responseBy    String @default("")
  /// "Updateable On" — the earliest an update can be filed.
  updateableOn  String @default("")
  updateBy      String @default("")
  expiresOn     String @default("")

  /// The dig site as 811 recorded it. Held because it is the only coordinate
  /// anyone states for this work, and it is what puts a ticket on a map
  /// beside the crews.
  lat                Float?
  lng                Float?
  /// Verbatim from the ticket. These say where to start and what to walk, and
  /// paraphrasing them would lose the only site-specific instruction there is.
  locateInstructions String @default("")

  /// Set when a ticket is cancelled or superseded, so it drops out of the
  /// board without being deleted — a locate history is a safety record.
  closedOn String @default("")
  notes    String @default("")

  /// Which one-call centre issued this. GA811 today; the adapter layer means
  /// AL811 and SC811 are a row here rather than a fork in the code.
  provider String @default("GA811")
  /// Two-letter state, so a multi-state board can be read by market.
  state    String @default("GA")

  /// The crew this work belongs to. Crews are subcontractors here — the same
  /// record a daily, an invoice and a project assignment already hang off.
  crew   Subcontractor? @relation(fields: [crewId], references: [id], onDelete: SetNull)
  crewId String?

  /// Who in the office owns chasing this one.
  assignedTo   User?   @relation("LocateAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  excavatorName       String @default("")
  contactName         String @default("")
  contactPhone        String @default("")
  workAreaDescription String @default("")

  /// Where the ticket is in its own life. Kept apart from readiness on
  /// purpose: a ticket can be perfectly ACTIVE and still unworkable.
  lifecycle LocateLifecycle @default(NEW)

  /// Whether 811 has done its part, and whether the ground is actually safe to
  /// open. These are two different questions and conflating them is how a crew
  /// digs on a ticket that reads green.
  externalReadiness ExternalReadiness @default(UNKNOWN)
  fieldReadiness    FieldReadiness    @default(UNKNOWN)
  /// Why, in a sentence, in the words a foreman would use. Stored so the board
  /// and a text message say the same thing as the detail page.
  blockingReason    String            @default("")

  /// Monitoring. A ticket stops being checked when the work is done, not when
  /// somebody remembers to turn it off.
  monitoringEnabled Boolean   @default(true)
  lastCheckedAt     DateTime?
  nextCheckAt       DateTime?
  lastChangedAt     DateTime?
  sourceUrl         String    @default("")
  /// Hash of the last snapshot, so an unchanged check is cheap to recognise
  /// and does not manufacture a change event.
  rawSourceHash     String    @default("")

  responses         LocateResponse[]
  contractorLocates ContractorLocate[]
  checks            LocateTicketCheck[]
  changes           LocateTicketChange[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([number, revision])
  @@index([projectId])
  @@index([expiresOn])
  @@index([crewId])
  @@index([provider, number])
  @@index([externalReadiness])
  @@index([fieldReadiness])
  @@index([monitoringEnabled, nextCheckAt])
  @@index([lifecycle])
}

model LocateResponse {
  id       String       @id @default(cuid())
  ticket   LocateTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  /// The utility, as 811 names them.
  member       String
  /// The 811 member code, which is what appears on a response.
  code         String               @default("")
  /// Gas, Electric, Water, Telecommunication. Not decoration: what is in the
  /// ground decides how badly a missing response matters.
  facilityType String               @default("")
  status       LocateResponseStatus @default(UNKNOWN)
  respondedOn  String               @default("")
  note         String               @default("")

  /// The centre's own code and wording, kept verbatim beside our reading of
  /// it. When a normalisation turns out to be wrong, this is what says so.
  responseCode        String @default("")
  responseDescription String @default("")
  rawResponse         String @default("")

  @@unique([ticketId, member])
  @@index([ticketId])
}


/// A person at a subcontractor — the foreman who files dailies, the office
/// manager who chases an invoice, the owner who signs.
///
/// One company had one phone number and one email, which is fine until the
/// foreman entering the billing is not the owner whose number is on the packet.
/// A task assigned to a person could not be texted at all, because a person had
/// nowhere to hold a number.
///
/// Captured at the top of onboarding on purpose: a crew who abandons the form
/// half way still leaves behind who they are and how to ring them, which is the
/// thing that gets forgotten when several companies are onboarding at once.
model CrewContact {
  id              String        @id @default(cuid())
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  name            String        @default("")
  /// Foreman, owner, office — free text, because job titles in this trade are
  /// not a list anybody agrees on.
  role            String        @default("")
  phone           String        @default("")
  email           String        @default("")
  /// The one to ring when it is not about a specific job.
  primary         Boolean       @default(false)
  /// Their own consent, because consent belongs to a handset and not a company.
  smsConsentAt    DateTime?
  smsOptOutAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([subcontractorId])
}
/// A physical place material is stored for a project.
///
/// A project can have several — a main yard and satellites — and a yard can
/// serve more than one project, so the link between them lives on the
/// transaction rather than being a column here.
model Yard {
  id            String  @id @default(cuid())
  name          String
  /// Scalar ids rather than Prisma relations, deliberately. Adding relation
  /// fields means editing Project and Subcontractor, and every model touched
  /// is a chance to break a schema that thirty other things depend on. These
  /// carry the same information and are indexed the same way.
  projectId     String  @default("")
  customerId    String  @default("")
  primeContractor String @default("")
  state         String  @default("")
  market        String  @default("")
  county        String  @default("")
  city          String  @default("")
  address       String  @default("")
  lat           Float?
  lng           Float?
  managerName   String  @default("")
  managerPhone  String  @default("")
  hours         String  @default("")
  status        String  @default("ACTIVE")
  notes         String  @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([customerId])
}

/// Every movement of material, ever.
///
/// This is the foundation the rest of yard control stands on. ProjectMaterial
/// holds `issued` and `installed` as plain numbers with no history: somebody
/// changes 6,000 to 8,000 and there is no record that it happened, who did it
/// or why. Custody, returns, remnants, transfers, variance and audit all need
/// the inverse — a ledger these numbers are derived from rather than stored
/// beside.
///
/// Nothing is ever edited here. A mistake is corrected by writing an ADJUST
/// row with a reason, so the trail of what was believed and when survives.
model MaterialTransaction {
  id        String @id @default(cuid())

  /// RECEIVE, ISSUE, RETURN, INSTALL, TRANSFER, ADJUST, DAMAGE, COUNT.
  kind      String
  /// The material this moved, by code — the same code the rate card and the
  /// daily sheet use, so the three can be reconciled without a mapping table.
  code      String
  /// Positive adds to the yard, negative takes away. An ISSUE is negative, a
  /// RETURN positive — so on-hand is the sum, and no reader has to know which
  /// kinds count which way.
  quantity  Float
  unit      String @default("")

  projectId String @default("")
  yardId    String @default("")
  /// Who holds it after this movement. Empty means the yard does.
  custodianSubId String @default("")
  crew           String @default("")
  /// Reel this came off, where the material is reel-tracked.
  reelNumber     String @default("")

  /// The physical thing that moved, where there is one. The reel number above
  /// stays populated for movements predating instances and for unit material
  /// nobody serialises.
  instance   MaterialInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  instanceId String?

  /// The pickup or delivery this was part of.
  session   MaterialSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId String?

  /// Custody either side of the movement, frozen. Deriving it later from
  /// neighbouring rows is how a history starts disagreeing with itself.
  fromSubId    String @default("")
  fromCrew     String @default("")
  fromPerson   String @default("")
  fromLocation String @default("")
  toSubId      String @default("")
  toCrew       String @default("")
  toPerson     String @default("")
  toLocation   String @default("")

  vehicle String @default("")
  trailer String @default("")

  /// The daily that consumed it, when the movement came from production rather
  /// than from somebody at a keyboard.
  sourceDailyId String @default("")
  /// manual | daily | ai_intake | request
  source        String @default("manual")

  /// On a COUNT: what was expected, what was found, and why they differ.
  expectedQty    Float?
  actualQty      Float?
  varianceReason String @default("")

  /// Paperwork behind the movement.
  reference String @default("")
  /// Required on ADJUST. Why the number moved without material moving.
  reason    String @default("")
  photos    Json   @default("[]")

  /// Who did it, and who signed for it.
  actorUserId  String @default("")
  receivedBy   String @default("")
  signatureUrl String @default("")

  at        DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([projectId, code])
  @@index([yardId])
  @@index([reelNumber])
  @@index([custodianSubId])
  @@index([at])
  @@index([instanceId, at])
  @@index([sessionId])
  @@index([sourceDailyId])
}

/// Proof that a person agreed to be texted.
///
/// A carrier reviewing an A2P campaign asks two things: show us where someone
/// consents, and show us the record of them consenting. The consent box inside
/// the crew portal answers neither — a reviewer with no account sees a login
/// page, which is what got the campaign rejected.
///
/// The exact wording is stored on the row rather than referenced, because the
/// wording will change and a consent record has to say what was actually
/// agreed to on the day, not what the page says now.
model SmsOptIn {
  id        String @id @default(cuid())
  /// E.164. The identity of the consent — everything else is context.
  phone     String
  name      String @default("")
  company   String @default("")
  /// The consent language exactly as it appeared when they ticked it.
  consentText String
  /// Where they were when they agreed, for an audit trail.
  source    String @default("web")
  ip        String @default("")
  userAgent String @default("")
  consentedAt DateTime @default(now())
  /// Set when they reply STOP, or ask us to stop by any other means.
  revokedAt DateTime?
  revokedVia String  @default("")

  @@index([phone])
}

/// Money actually sent to a crew.
///
/// Separate from Payment, which records money coming in from a customer. The
/// two directions share a shape and nothing else: mixing them would put what
/// we owe and what we are owed one careless where-clause apart.
///
/// Marking a statement PAID used to store the word and nothing else — not the
/// amount, not the day the money moved, not the trace number. Six months on,
/// "which payment covered that week" had no answer.
model SubPayment {
  id         String     @id @default(cuid())
  invoice    SubInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  amount     Float      @default(0)
  /// The day the money moved, as YYYY-MM-DD. The bank's date, not today's —
  /// a payment entered on Monday for a Friday ACH is a Friday payment.
  paidOn     String     @default("")
  /// ACH or WIRE. Fast pay is wire; standard terms settle by ACH.
  method     String     @default("ACH")
  /// The bank's trace or confirmation number. This is what a crew quotes
  /// when they ring to say they cannot find it.
  reference  String     @default("")
  note       String     @default("")
  recordedBy String     @default("")
  createdAt  DateTime   @default(now())

  @@index([invoiceId])
}

/// An invitation to join a subcontractor as one of their people.
///
/// Separate from Invite, which brings a whole company onto the platform. This
/// one adds a person to a company that already exists, which is a different
/// act with a different authority: staff issue it, and it names the company
/// and the job before the person ever sees it, so nothing they type can put
/// them somewhere else.
model SubUserInvite {
  token           String      @id
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String
  email           String
  name            String      @default("")
  subUserRole     SubUserRole @default(FOREMAN)
  used            Boolean     @default(false)
  invitedBy       String      @default("")
  createdAt       DateTime    @default(now())

  @@index([subcontractorId])
}

/* ------------------------------------------------------------------ *
 * Messaging.
 *
 * A conversation is attached to the work it is about. That is the whole
 * point of it living here rather than in anybody's phone: a foreman's text
 * about a damaged ped is the only record of why a daily was short, and it
 * currently lives in a thread nobody else can read.
 *
 * Built so SMS can be switched on later without moving anything. A message is
 * stored once; how it reached somebody is a separate row per recipient per
 * channel, because "sent" and "sent to Jose's phone and failed on Marlon's"
 * are different facts.
 * ------------------------------------------------------------------ */

enum ConversationType {
  /// One person to one person.
  DIRECT
  /// The office and a crew. One thread here, one SMS each on the way out.
  CREW
  /// Everybody on a job.
  PROJECT
  /// The office and a subcontracting company.
  SUBCONTRACTOR
}

enum MessageDirection {
  /// From Fortitude outwards.
  OUTBOUND
  /// From a crew, a sub or a handset, inwards.
  INBOUND
}

enum MessageKind {
  /// Somebody typed it.
  USER
  /// The app recording something that happened — a task assigned, a
  /// participant added, an SMS that failed. Never a chat bubble.
  SYSTEM
  /// Sent by a rule rather than a person. Looks like a message because it is
  /// one, but it is attributable to the automation that raised it.
  AUTOMATED
}

enum DeliveryChannel {
  IN_APP
  SMS
}

enum DeliveryStatus {
  /// Accepted by us, not yet handed to a provider.
  QUEUED
  /// Handed over.
  SENT
  /// The carrier says it arrived.
  DELIVERED
  FAILED
  /// An inbound message — it arrived here.
  RECEIVED
  /// Deliberately not attempted: no consent, no number, channel disabled.
  /// Distinct from FAILED, which means we tried.
  SKIPPED
}

/// Whether somebody may lawfully be texted.
///
/// UNKNOWN is the default and it means "do not send". Consent is a thing
/// somebody gives, not a thing absent data implies.
enum SmsConsent {
  UNKNOWN
  GRANTED
  REVOKED
}

/// Somebody reachable who has no Vantara login.
///
/// A crew's second foreman, a customer's inspector, the man who answers the
/// phone at a supplier. They can be in a conversation and receive a text
/// without an account, and a number is the identity — normalised to E.164 so
/// "(864) 555-0134" and "+18645550134" cannot become two people.
model MessageContact {
  id   String  @id @default(cuid())
  name String  @default("")
  /// E.164. Unique, because that is what stops the same person arriving twice.
  phoneE164 String @unique
  email     String @default("")

  /// The company they belong to, when they belong to one.
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  subcontractorId String?

  consent     SmsConsent @default(UNKNOWN)
  optInAt     DateTime?
  optOutAt    DateTime?
  /// Where the consent came from — the packet, the public page, a staff note.
  consentSource String   @default("")

  participants ConversationParticipant[]
  sentMessages Message[]
  deliveries   MessageDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subcontractorId])
}

model Conversation {
  id    String           @id @default(cuid())
  type  ConversationType
  title String           @default("")
  /// What it is about, in a few words — "COI request", "Reynolds Rd rework".
  subject String         @default("")

  /// The work this is attached to. All optional and all indexed: a
  /// conversation usually has one, occasionally two, and the pairing is what
  /// stops a second thread being opened for the same thing.
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId       String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  subcontractorId String?
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId          String?
  /// Plain ids rather than relations: a daily or a locate being deleted must
  /// not take the conversation about it with them.
  dailyId  String @default("")
  locateId String @default("")

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Denormalised so the inbox can sort without touching every message.
  lastMessageAt   DateTime  @default(now())
  archivedAt      DateTime?

  participants ConversationParticipant[]
  messages     Message[]
  events       ConversationEvent[]

  @@index([type, lastMessageAt])
  @@index([projectId])
  @@index([subcontractorId])
  @@index([taskId])
}

/// Somebody in a conversation, and what they have read.
///
/// Read state is per participant and never a flag on the conversation: two
/// people reading the same thread have different unread counts, and one of
/// them marking it read must not clear it for the other.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  /// Exactly one of these three identifies the participant.
  user            User?           @relation("ConversationMember", fields: [userId], references: [id], onDelete: Cascade)
  userId          String?
  contact         MessageContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String?
  /// A whole company, for a thread with a subcontractor rather than a person.
  subcontractor   Subcontractor?  @relation("ConversationCrew", fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorId String?

  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  lastReadAt DateTime?

  @@unique([conversationId, userId])
  @@unique([conversationId, contactId])
  @@unique([conversationId, subcontractorId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  senderUser      User?           @relation("MessageAuthor", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderUserId    String?
  senderContact   MessageContact? @relation(fields: [senderContactId], references: [id], onDelete: SetNull)
  senderContactId String?
  /// Kept as text as well, so a deleted account does not erase who said it.
  senderName      String          @default("")

  direction MessageDirection @default(OUTBOUND)
  kind      MessageKind      @default(USER)
  body      String

  attachments MessageAttachment[]
  deliveries  MessageDelivery[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String  @id @default(cuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  url       String
  name      String  @default("")
  contentType String @default("")
  bytes     Int     @default(0)

  @@index([messageId])
}

/// One attempt to get one message to one recipient by one channel.
///
/// Separate from the message because a crew thread is one message and five
/// deliveries, and four of them succeeding is not the same as all five.
model MessageDelivery {
  id        String  @id @default(cuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String

  channel DeliveryChannel
  status  DeliveryStatus  @default(QUEUED)

  toUser      User?           @relation("MessageRecipient", fields: [toUserId], references: [id], onDelete: SetNull)
  toUserId    String?
  toContact   MessageContact? @relation(fields: [toContactId], references: [id], onDelete: SetNull)
  toContactId String?
  /// The number it actually went to, frozen — a contact's number can change.
  toPhoneE164 String          @default("")

  provider String @default("")
  /// The provider's own id. Unique, and it is what makes webhook processing
  /// idempotent: the same SID arriving twice updates one row rather than
  /// creating a second.
  providerMessageId String? @unique
  errorCode         String  @default("")
  errorMessage      String  @default("")

  queuedAt    DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  @@index([messageId])
  @@index([status])
}

/// The audit trail.
///
/// Kept apart from messages so the thread stays readable: "Sean added Jose"
/// belongs in a history, not between two sentences somebody typed. System
/// messages that a reader should see are Messages with kind SYSTEM; this is
/// everything else, including provider detail nobody needs in the UI.
model ConversationEvent {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  /// created | participant_added | participant_removed | message_sent |
  /// sms_attempted | sms_delivered | sms_failed | sms_received | linked |
  /// reminder_sent | read
  kind   String
  detail String @default("")
  actor  String @default("")
  /// Provider payloads and ids, for debugging. Never rendered to a crew.
  meta   Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

/// A reusable operational message.
///
/// The foundation only. Nothing sends on a schedule yet — this is what a
/// reminder will be written from once consent and configuration allow it.
model MessageTemplate {
  id   String @id @default(cuid())
  /// task_assigned | task_reminder | coi_expiring | daily_missing | locate_clear
  key  String @unique
  name String
  body String
  /// Which placeholders the body understands, for whoever edits it later.
  tokens String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 * Material chain of custody.
 *
 * The distinction everything below depends on: "288ct SM Fiber" is a material,
 * "Reel R-88142" is a thing you can put on a truck. The ledger tracked
 * material by code, which answers how much a job used and cannot answer who
 * has it — and who has it is the question being asked when 480 ft is missing.
 *
 * Custody is derived from events and cached on the instance. Every movement is
 * an event; the instance carries the latest one so a list of two hundred reels
 * does not replay two thousand movements to draw itself. Nothing overwrites
 * history.
 * ------------------------------------------------------------------ */

enum MaterialInstanceStatus {
  /// Booked in, not yet available to issue.
  RECEIVED
  AVAILABLE
  /// Held for a job so nobody else issues it.
  RESERVED
  CHECKED_OUT
  IN_TRANSIT
  /// Issued and being drawn down.
  ACTIVE
  LOW
  NEARLY_EMPTY
  RETURNED
  DAMAGED
  QUARANTINED
  /// The numbers do not add up and somebody has to look.
  RECONCILE
  CLOSED
  DISPOSED
}

/// A physical, identifiable piece of material.
///
/// A reel, a pallet, a bundle — anything with a number on the side. Unit
/// material nobody serialises does not need one; the code-level ledger already
/// handles a pile of handholes.
model MaterialInstance {
  id String @id @default(cuid())

  /// The material code, the same one the rate card and the daily sheet use, so
  /// the three reconcile without a mapping table between them.
  code        String
  description String @default("")
  category    String @default("Hardware")
  unit        String @default("ft")

  /// What is written on the side. Unique with the code: two suppliers can both
  /// ship an "R-1", and the same reel on the same material is the duplicate
  /// worth refusing.
  reelNumber   String @default("")
  lotNumber    String @default("")
  serialNumber String @default("")
  manufacturer String @default("")
  partNumber   String @default("")

  /// What it held on arrival. The denominator for everything after.
  originalQty Float @default(0)

  status MaterialInstanceStatus @default(RECEIVED)

  yardId          String  @default("")
  locationLabel   String  @default("")
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId       String?
  custodian       Subcontractor? @relation("MaterialCustodian", fields: [custodianSubId], references: [id], onDelete: SetNull)
  custodianSubId  String?
  crew            String  @default("")
  /// The person answerable for it, by name. A crew's staff change, and a
  /// custody record naming only a company answers nobody.
  responsibleName String  @default("")
  vehicle         String  @default("")
  trailer         String  @default("")

  checkedOutAt DateTime?
  issuedByName String    @default("")

  lastVerifiedAt  DateTime?
  lastVerifiedQty Float?
  lastVerifiedBy  String    @default("")

  supplier       String @default("")
  poNumber       String @default("")
  shipmentNumber String @default("")

  events   MaterialTransaction[]
  sessions MaterialSessionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, reelNumber])
  @@index([status])
  @@index([projectId])
  @@index([custodianSubId])
  @@index([reelNumber])
  @@index([code])
}

/// One pickup, one delivery, one transfer, one return.
///
/// A crew does not come for a reel; they come for a reel, twelve handholes and
/// twenty ground rods, and they sign once. Grouping the movements makes that
/// one event in the history rather than thirty-three.
model MaterialSession {
  id   String @id @default(cuid())
  /// RECEIPT | PICKUP | TRANSFER | RETURN
  kind String

  reference String @default("")

  projectId      String @default("")
  custodianSubId String @default("")
  crew           String @default("")
  yardId         String @default("")

  /// Who physically took it, and what they do. The most useful field on this
  /// table when a dispute starts eight weeks later.
  personName String @default("")
  personRole String @default("")
  vehicle    String @default("")
  trailer    String @default("")

  actorUserId String @default("")
  actorName   String @default("")

  acknowledgedBy      String @default("")
  acknowledgedAt      DateTime?
  acknowledgementText String @default("")
  signatureUrl        String @default("")

  supplier       String @default("")
  poNumber       String @default("")
  shipmentNumber String @default("")

  photos Json   @default("[]")
  notes  String @default("")

  items  MaterialSessionItem[]
  events MaterialTransaction[]

  at        DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([kind, at])
  @@index([projectId])
  @@index([custodianSubId])
}

model MaterialSessionItem {
  id        String          @id @default(cuid())
  session   MaterialSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  instance   MaterialInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  instanceId String?

  code     String
  quantity Float
  unit     String @default("")
  notes    String @default("")

  @@index([sessionId])
  @@index([instanceId])
}

/// Why a count came out different.
///
/// A table rather than an enum, because the list is a business decision and
/// adding one should not need a deploy.
model VarianceReason {
  id           String  @id @default(cuid())
  label        String  @unique
  /// Whether choosing it forces a comment.
  needsComment Boolean @default(false)
  active       Boolean @default(true)
  sortOrder    Int     @default(0)
}

/// Somebody at a prospect company.
///
/// A company is not a phone number. The estimator who answers about rates and
/// the owner who signs the agreement are different people, and a CRM that holds
/// one of them makes somebody hunt for the other in a note.
model ProspectContact {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  name    String
  title   String @default("")
  phone   String @default("")
  email   String @default("")
  /// phone | text | email
  prefers String @default("")
  primary Boolean @default(false)
  notes   String @default("")

  createdAt DateTime @default(now())

  @@index([prospectId])
}

/// What they own, as rows rather than a sentence.
///
/// "24x40, couple of mini-ex, missile setup" cannot be searched. A prime
/// asking who has two directional drills in Georgia needs this to be data.
model ProspectEquipment {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  /// Directional drill | Plow | Missile | Excavator | Vac trailer | Truck | Other
  category     String @default("Other")
  manufacturer String @default("")
  model        String @default("")
  quantity     Int    @default(1)
  /// owned | leased | rented
  ownership    String @default("owned")
  notes        String @default("")

  createdAt DateTime @default(now())

  @@index([prospectId])
  @@index([category])
  @@index([model])
}

/// What they can actually do, and how well.
model ProspectCapability {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  trade String
  /// primary | secondary | occasional
  level String @default("primary")
  /// Production they claim, in whatever unit the trade is measured in —
  /// footage for plough, shots for missile. Assuming feet breaks half of them.
  productionQty  Float  @default(0)
  productionUnit String @default("ft")
  productionPer  String @default("week")
  notes String @default("")

  @@unique([prospectId, trade])
  @@index([trade])
}

/// What they want to be paid.
///
/// Keyed on the same unit code the rate cards and daily sheets use, so a
/// prospect's expectation can be held against a customer's rate without a
/// mapping table in between.
model ProspectRate {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  code        String
  description String @default("")
  unit        String @default("ft")
  rate        Float  @default(0)
  notes       String @default("")

  createdAt DateTime @default(now())

  @@unique([prospectId, code])
  @@index([code])
}

/// Availability as it changed, not just as it stands.
///
/// "Committed through the 20th" said in August is what tells you in September
/// that they are free now. Overwriting it loses the only forward-looking thing
/// a recruiter has.
model ProspectAvailabilityEntry {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  status    ProspectAvailability
  crews     Int      @default(0)
  fromDate  String   @default("")
  note      String   @default("")
  recordedBy String  @default("")
  createdAt DateTime @default(now())

  @@index([prospectId, createdAt])
}

/// One line of the prequalification checklist.
model ProspectQualification {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  /// company | insurance | w9 | safety | references | equipment | rates |
  /// geography | availability | agreement | nda
  item   String
  /// missing | received | review | complete | na
  status String @default("missing")
  note   String @default("")
  /// For anything that lapses.
  expiresOn String @default("")
  updatedBy String @default("")
  updatedAt DateTime @updatedAt

  @@unique([prospectId, item])
}

model ProspectReference {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  company      String
  contactName  String @default("")
  phone        String @default("")
  email        String @default("")
  relationship String @default("")
  projects     String @default("")
  notes        String @default("")
  verifiedOn   String @default("")
  verifiedBy   String @default("")

  createdAt DateTime @default(now())

  @@index([prospectId])
}

/// Work being pursued with a prime.
///
/// A prime prospect is not a person to recruit; it is a relationship with
/// bids attached, and the bids are what the pipeline is actually about.
model ProspectOpportunity {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String

  name   String
  market String @default("")
  /// identified | qualified | bid_requested | bid_prep | bid_submitted |
  /// negotiating | awarded | lost
  stage  String @default("identified")
  estimatedValue Float @default(0)
  probability    Int   @default(0)
  bidDue         String @default("")
  expectedAward  String @default("")
  owner  String @default("")
  notes  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prospectId])
  @@index([stage])
}

/// Where a ticket sits in its own life, independent of whether anyone may dig.
enum LocateLifecycle {
  NEW
  ACTIVE
  UPDATED
  EXPIRING
  EXPIRED
  CANCELLED
  COMPLETED
}

/// Has 811 done its part?
///
/// This answers one question only: have the utilities we are waiting on
/// answered acceptably, on a ticket that is in force. It says nothing about
/// whether the ground is safe to open.
enum ExternalReadiness {
  WAITING_ON_811
  READY
  NOT_EFFECTIVE_YET
  NEEDS_REVIEW
  LOOKUP_ERROR
  EXPIRED
  UNKNOWN
}

/// May a crew actually put steel in the ground here?
///
/// The distinction from ExternalReadiness is the point of this whole module.
/// On the Windstream jobs Fortitude locates Windstream's own plant, so 811 can
/// be entirely finished while the one locate that matters has not been walked.
/// A single "ready" flag would have said yes.
enum FieldReadiness {
  NOT_READY
  CONTRACTOR_LOCATE_REQUIRED
  CONTRACTOR_LOCATE_IN_PROGRESS
  CONTRACTOR_LOCATE_ISSUE
  FIELD_READY
  EXPIRED
  UNKNOWN
}

/// Who walks a given utility on a given job.
enum LocatePerformedBy {
  /// The 811 member sends a locator and posts a response.
  MEMBER
  /// We do it — Fortitude locates it and documents it.
  CONTRACTOR
  /// Somebody else contracted to do it.
  THIRD_PARTY
}

enum ContractorLocateStatus {
  NOT_REQUIRED
  REQUIRED
  ASSIGNED
  IN_PROGRESS
  VERIFIED
  ISSUE_FOUND
  UNABLE_TO_LOCATE
  REQUIRES_ESCALATION
}

enum LocateCheckType {
  AUTOMATIC
  MANUAL
  IMPORT
}

enum LocateChangeKind {
  UTILITY_RESPONSE_CHANGED
  EXTERNAL_READINESS_CHANGED
  FIELD_READINESS_CHANGED
  EXPIRATION_CHANGED
  EFFECTIVE_DATE_CHANGED
  ADDRESS_CHANGED
  TICKET_UPDATED
  CONTRACTOR_LOCATE_CHANGED
  LIFECYCLE_CHANGED
}

/// Who is responsible for locating a given utility on a given job.
///
/// Deliberately per project rather than a global list. Fortitude locates
/// Windstream on the Windstream builds and nowhere else, and a hardcoded
/// "Windstream never blocks" would quietly clear a ticket on a job where
/// Windstream really is supposed to send somebody.
model ProjectLocateRule {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  /// Matched case-insensitively against the member name 811 states, so
  /// "WINDSTREAM" catches "WINDSTREAM COMMUNICATIONS - WIN01".
  utilityName String
  utilityCode String @default("")

  performedBy LocatePerformedBy @default(MEMBER)

  /// A contractor-performed utility does not hold up 811 readiness — nobody is
  /// waiting on a response that is never coming. It absolutely holds up field
  /// readiness, which is the flag that decides whether a crew digs.
  blocks811Readiness   Boolean @default(false)
  blocksFieldReadiness Boolean @default(true)

  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, utilityName])
  @@index([projectId])
}

/// A locate we perform ourselves, and the evidence that we did.
///
/// This is a safety record before it is a workflow. It keeps who walked it,
/// when, with what frequency, and the photographs — because the question that
/// eventually gets asked is not "was it marked" but "who marked it and how do
/// we know".
model ContractorLocate {
  id       String       @id @default(cuid())
  ticket   LocateTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  utilityName String
  utilityCode String                 @default("")
  status      ContractorLocateStatus @default(REQUIRED)

  /// The crew carrying it, and the person who actually walked it. Both,
  /// because the crew is who to call and the person is who to ask.
  assignedCrew   Subcontractor? @relation(fields: [assignedCrewId], references: [id], onDelete: SetNull)
  assignedCrewId String?
  assignedTo     User?          @relation("ContractorLocateAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId   String?
  locatedBy      User?          @relation("ContractorLocateLocator", fields: [locatedById], references: [id], onDelete: SetNull)
  locatedById    String?
  locatedAt      DateTime?

  /// What was on the transmitter and how well it came back. A locate walked at
  /// the wrong frequency is a locate that found nothing, and the reading is
  /// what lets somebody else judge that later.
  frequencyUsed String @default("")
  signalQuality String @default("")

  notes  String @default("")
  /// Blob URLs, same shape as every other photo set here.
  photos Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticketId, utilityName])
  @@index([ticketId])
  @@index([assignedCrewId])
  @@index([status])
}

/// Every lookup ever attempted against a ticket, successful or not.
///
/// Never overwritten. A board that says a ticket is clear has to be able to
/// show when it last actually asked, and a failed check that quietly left the
/// old answer on screen is the failure mode worth being able to prove.
model LocateTicketCheck {
  id       String       @id @default(cuid())
  ticket   LocateTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  checkedAt     DateTime        @default(now())
  checkType     LocateCheckType @default(MANUAL)
  requestedBy   User?           @relation("LocateCheckRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById String?

  success         Boolean @default(false)
  /// What the adapter reported: OK, GA811_LOOKUP_UNAVAILABLE, PARSE_FAILED…
  providerStatus  String  @default("")
  httpStatus      Int?
  sourceHash      String  @default("")
  rawSnapshot     String  @default("")
  changesDetected Int     @default(0)
  errorMessage    String  @default("")
  durationMs      Int     @default(0)

  changes LocateTicketChange[]

  @@index([ticketId, checkedAt])
  @@index([checkedAt])
}

/// What actually moved between one check and the next.
///
/// The board's "what changed since this morning" is this table read back, not
/// a diff recomputed on the fly against data that has already been overwritten.
model LocateTicketChange {
  id       String       @id @default(cuid())
  ticket   LocateTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  check   LocateTicketCheck? @relation(fields: [checkId], references: [id], onDelete: SetNull)
  checkId String?

  kind LocateChangeKind
  /// What moved — a utility name, "Expires on", "Field readiness".
  subject   String @default("")
  fromValue String @default("")
  toValue   String @default("")
  /// One sentence a person can read without decoding the enums.
  summary   String @default("")
  /// Set when a person caused it rather than a lookup.
  actor     String @default("")

  at DateTime @default(now())

  @@index([ticketId, at])
  @@index([at])
}

/// Small pieces of configuration a person can change without a deploy.
///
/// Introduced for the alerts kill switch. Environment variables are the right
/// home for credentials and for whether a thing is provisioned at all, but they
/// are the wrong home for a control somebody needs at 6am when texts are going
/// out that should not be — that one has to be a switch in the product, and it
/// has to be reversible by the person who notices.
model AppSetting {
  key   String @id
  value String

  updatedBy String   @default("")
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
